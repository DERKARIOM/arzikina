<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Automatisation — heure de déclenchement (voir cahier des charges "Ajouter l'heure de
        déclenchement à Automatisation", work/AutomationScheduler.kt) :
        - RECEIVE_BOOT_COMPLETED : nécessaire pour que work/BootCompletedReceiver.kt reçoive la
          diffusion système au redémarrage du téléphone et reprogramme les alarmes AlarmManager
          (qui ne survivent jamais à un redémarrage). Pas de permission SCHEDULE_EXACT_ALARM/
          USE_EXACT_ALARM : choix délibéré (voir AutomationSchedulerImpl.kt), setAndAllowWhileIdle
          n'en nécessite aucune.
        - POST_NOTIFICATIONS (Android 13+) : nécessaire pour que work/AutomationNotifier.kt puisse
          afficher son rappel — demandée à l'exécution depuis RecurringTransactionsFragment
          (voir sa doc), cette simple déclaration ne l'accorde pas automatiquement.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Visibilité des packages (Android 11+, voir util/external/ExternalAppLauncher) : SEULE
        déclaration nécessaire pour la fonctionnalité "Lancer l'application Mobile Money depuis un
        compte" — rend visibles TOUTES les applications ayant une icône de lancement (même filtre
        qu'un launcher système), ce qui suffit à la fois pour détecter les applications
        installées dans le sélecteur ET pour vérifier/lancer un package déjà enregistré sur un
        compte (une application Mobile Money a nécessairement une activité de lancement).
        Volontairement PAS la permission QUERY_ALL_PACKAGES (nécessite une justification Play
        Store, bien plus large que ce dont cette fonctionnalité a besoin) ni une liste de packages
        codés en dur (voir cahier des charges, section 16 : "ne pas ajouter un <queries> trop
        large inutilement" — ce bloc est le minimum standard documenté par Android pour ce cas
        d'usage précis).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ArzikinaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/arzikina_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/arzikina_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Arzikina">

        <!--
            Désactive l'initialisation automatique de WorkManager (contribuée par sa propre
            fusion de manifeste via App Startup) : ArzikinaApplication fournit sa propre
            Configuration (voir Configuration.Provider, HiltWorkerFactory) — les deux ensemble
            lèveraient une IllegalStateException au démarrage ("WorkManager is already
            initialized"). Voir la doc officielle WorkManager, "Custom Configuration".
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Automatisation — heure de déclenchement (voir work/AutomationScheduler.kt et le bloc de
            permissions en tête de ce fichier).
            - AutomationAlarmReceiver : exported="false", uniquement destiné aux PendingIntent posés
              par AutomationSchedulerImpl (voir sa doc) — aucune app tierce ne doit pouvoir déclencher
              cette diffusion.
            - BootCompletedReceiver : exported="true", indispensable pour recevoir BOOT_COMPLETED/
              MY_PACKAGE_REPLACED, tous deux des diffusions PROTÉGÉES (seul le système peut les
              envoyer, voir sa documentation officielle) — exported="true" ne les rend donc pas
              usurpables par une app tierce, contrairement à une diffusion non protégée.
        -->
        <!--
            Gestion des reçus (voir data/receipts/ReceiptFileStorage.kt, res/xml/file_paths.xml) :
            expose UNIQUEMENT files/receipts/ (voir ce fichier XML) via une URI content:// sécurisée
            — jamais un chemin de fichier privé exposé directement (cahier des charges section 9).
            exported="false"/grantUriPermissions="true" : combinaison standard et obligatoire pour
            un FileProvider (seules les URI explicitement accordées via un Intent sont lisibles par
            l'app destinataire, jamais tout le provider).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".work.AutomationAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".work.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            windowSoftInputMode="adjustResize" : bonne pratique standard, mais À ELLE SEULE
            INSUFFISANTE ici — l'app est en edge-to-edge (voir util/SystemBars.kt,
            WindowCompat.setDecorFitsSystemWindows(window, false)), et Android cesse alors de
            redimensionner automatiquement le contenu selon le clavier, quelle que soit la valeur
            de cet attribut (comportement documenté officiellement). La correction réelle consiste
            à consommer manuellement l'inset WindowInsetsCompat.Type.ime() — voir
            SystemBars.applyImeAwarePadding(), appliqué automatiquement à chaque écran par
            MainActivity (registerFragmentLifecycleCallbacks), aucune configuration par Fragment.
        -->
        <!--
            android:launchMode="singleTask" (voir MainActivity.onNewIntent, data/receipts/) : une
            seule Activity dans toute l'app (voir sa doc de classe) — indispensable pour la réception
            du partage (cahier des charges "Gestion des reçus", section 1). Sans lui, partager un PDF
            alors qu'Arzikina est déjà ouverte créerait une DEUXIÈME instance de MainActivity
            empilée par-dessus la première (comportement standard "standard" d'Android pour une
            Activity ciblée par un nouvel Intent), dupliquant toute la navigation/le verrou
            biométrique. "singleTask" garantit qu'un Intent entrant est TOUJOURS livré à l'instance
            unique existante via onNewIntent, jamais une nouvelle instance.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Arzikina"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Gestion des reçus, section 1 : Arzikina doit apparaître dans le sélecteur de partage
                Android ("Share Sheet") pour tout fichier PDF (ex. reçu Mobile Money). Volontairement
                SEUL "application/pdf" (jamais "*/*" ni "application/*") : n'apparaître QUE pour le
                type de fichier réellement géré, jamais comme cible générique de tout partage.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>

</manifest>