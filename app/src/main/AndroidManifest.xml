<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".ArzikinaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_arsikina"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_arsikina"
        android:supportsRtl="true"
        android:theme="@style/Theme.Arzikina">

        <!--
            Désactive l'initialisation automatique de WorkManager (contribuée par sa propre
            fusion de manifeste via App Startup) : ArzikinaApplication fournit sa propre
            Configuration (voir Configuration.Provider, HiltWorkerFactory) — les deux ensemble
            lèveraient une IllegalStateException au démarrage ("WorkManager is already
            initialized"). Voir la doc officielle WorkManager, "Custom Configuration".
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            windowSoftInputMode="adjustResize" : bonne pratique standard, mais À ELLE SEULE
            INSUFFISANTE ici — l'app est en edge-to-edge (voir util/SystemBars.kt,
            WindowCompat.setDecorFitsSystemWindows(window, false)), et Android cesse alors de
            redimensionner automatiquement le contenu selon le clavier, quelle que soit la valeur
            de cet attribut (comportement documenté officiellement). La correction réelle consiste
            à consommer manuellement l'inset WindowInsetsCompat.Type.ime() — voir
            SystemBars.applyImeAwarePadding(), appliqué automatiquement à chaque écran par
            MainActivity (registerFragmentLifecycleCallbacks), aucune configuration par Fragment.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Arzikina"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>