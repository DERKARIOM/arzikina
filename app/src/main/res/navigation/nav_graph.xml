<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <!--
        Les 4 onglets de la Bottom Navigation (Accueil, Compte, Rapports,
        Autre). Les identifiants (@+id/...) correspondent exactement à ceux
        de menu/bottom_nav_menu.xml : MainActivity.setUpBottomNavigation s'en
        sert pour le câblage manuel (voir MainActivity.TAB_DESTINATION_IDS).

        Budget, Catégories, Paramètres et Transactions restent des
        destinations du graphe (donc atteignables par navigate()) mais ne
        sont plus des onglets directs : Budget/Catégories/Paramètres depuis
        l'onglet "Autre" (voir presentation/more/MoreFragment.kt), Transactions
        depuis le Dashboard ("Dernières transactions" → "Voir tout", voir
        DashboardFragment.kt) — pour ne garder que 4 onglets.
    -->

    <!--
        loginFragment / registerFragment : le startDestination déclaré ci-dessus
        (dashboardFragment) n'est qu'un repli pour Android Studio (aperçu de
        layout, etc.) — MainActivity.resolveStartDestination() écrase toujours
        ce choix au runtime, AVANT le premier affichage, selon qu'une session
        locale existe déjà ou non (voir MainActivity.kt). La Bottom Navigation
        est masquée sur ces deux destinations (voir la même méthode).
    -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.arzikina.ne.presentation.auth.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login" />

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.arzikina.ne.presentation.auth.RegisterFragment"
        android:label="@string/register_title"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.arzikina.ne.presentation.auth.ForgotPasswordFragment"
        android:label="@string/forgot_password_title"
        tools:layout="@layout/fragment_forgot_password" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.arzikina.ne.presentation.dashboard.DashboardFragment"
        android:label="@string/nav_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.arzikina.ne.presentation.transactions.TransactionsFragment"
        android:label="@string/nav_transactions"
        tools:layout="@layout/fragment_transactions" />

    <fragment
        android:id="@+id/transactionFormFragment"
        android:name="com.arzikina.ne.presentation.transactions.TransactionFormFragment"
        android:label="@string/transaction_form_title_add"
        tools:layout="@layout/fragment_transaction_form">
        <argument
            android:name="transactionId"
            android:defaultValue="0L"
            app:argType="long" />
        <!--
            0L = "aucun compte présélectionné" (même convention que
            transactionId). Renseigné uniquement par AccountDetailFragment,
            pour pré-remplir le compte quand on ajoute une transaction depuis
            l'écran "Détail du compte" (voir TransactionFormViewModel).
        -->
        <argument
            android:name="presetAccountId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.arzikina.ne.presentation.budget.BudgetFragment"
        android:label="@string/nav_budget"
        tools:layout="@layout/fragment_budget" />

    <fragment
        android:id="@+id/budgetFormFragment"
        android:name="com.arzikina.ne.presentation.budget.BudgetFormFragment"
        android:label="@string/budget_form_title_add"
        tools:layout="@layout/fragment_budget_form">
        <argument
            android:name="budgetId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.arzikina.ne.presentation.statistics.StatisticsFragment"
        android:label="@string/nav_statistics"
        tools:layout="@layout/fragment_statistics" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.arzikina.ne.presentation.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/moreFragment"
        android:name="com.arzikina.ne.presentation.more.MoreFragment"
        android:label="@string/nav_more"
        tools:layout="@layout/fragment_more" />

    <!--
        accountsFragment est l'onglet "Compte" (déclaré ici avec son propre
        écran de formulaire, pas dans le bloc des 5 onglets ci-dessus pour ne
        pas casser l'ordre historique du fichier, mais son id correspond bien
        à l'item "Compte" de bottom_nav_menu.xml). categoriesFragment reste,
        lui, un écran secondaire : atteint depuis l'onglet Autre (voir
        MoreFragment) ou depuis le raccourci du Dashboard, jamais un onglet.
    -->

    <fragment
        android:id="@+id/accountsFragment"
        android:name="com.arzikina.ne.presentation.accounts.AccountsFragment"
        android:label="@string/accounts_title"
        tools:layout="@layout/fragment_accounts" />

    <!--
        Destination JUMELLE de accountsFragment (même Fragment, id différent) : atteinte
        UNIQUEMENT via le raccourci "solde total" du Dashboard (voir DashboardFragment.kt).
        Nécessaire car accountsFragment est aussi l'id de l'onglet "Compte" de la Bottom
        Navigation (voir menu/bottom_nav_menu.xml) — NavigationUI.setupWithNavController
        (MainActivity.kt) coche automatiquement l'onglet dont l'id correspond à la
        destination courante, quel que soit le chemin emprunté pour l'atteindre. Sans cette
        destination séparée, cliquer sur le solde total depuis le Dashboard faisait passer
        la sélection de la Bottom Navigation sur "Compte" alors qu'on n'a pas quitté le
        contexte "Accueil". Comme cet id n'apparaît dans aucun item du menu, aucun onglet
        n'est reciblé et "Accueil" reste sélectionné. À réutiliser pour tout futur raccourci
        similaire (une destination-onglet atteinte en accès direct depuis un autre onglet).
    -->
    <fragment
        android:id="@+id/accountsFromDashboardFragment"
        android:name="com.arzikina.ne.presentation.accounts.AccountsFragment"
        android:label="@string/accounts_title"
        tools:layout="@layout/fragment_accounts" />

    <fragment
        android:id="@+id/accountFormFragment"
        android:name="com.arzikina.ne.presentation.accounts.AccountFormFragment"
        android:label="@string/account_form_title_add"
        tools:layout="@layout/fragment_account_form">
        <argument
            android:name="accountId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <!--
        Transactions d'UN compte, groupées par jour — atteint en cliquant sur
        un compte depuis accountsFragment (voir AccountsFragment.navigateToDetail).
        accountId n'a volontairement PAS de valeur par défaut : cet écran n'a
        de sens que pour un compte précis, contrairement à accountFormFragment
        (0L = "nouveau compte") ou transactionFormFragment.
    -->
    <fragment
        android:id="@+id/accountDetailFragment"
        android:name="com.arzikina.ne.presentation.accounts.AccountDetailFragment"
        android:label="@string/accounts_title"
        tools:layout="@layout/fragment_account_detail">
        <argument
            android:name="accountId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.arzikina.ne.presentation.categories.CategoriesFragment"
        android:label="@string/categories_title"
        tools:layout="@layout/fragment_categories" />

    <fragment
        android:id="@+id/categoryFormFragment"
        android:name="com.arzikina.ne.presentation.categories.CategoryFormFragment"
        android:label="@string/category_form_title_add"
        tools:layout="@layout/fragment_category_form">
        <argument
            android:name="categoryId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <!--
        profileFragment : atteint depuis l'onglet "Autre" (voir MoreFragment),
        comme budgetFragment/categoriesFragment/settingsFragment. Pas dans
        AUTH_DESTINATION_IDS (MainActivity.kt) : la Bottom Navigation reste
        visible ici, contrairement à Connexion/Inscription/Mot de passe oublié.
    -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.arzikina.ne.presentation.profile.ProfileFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.arzikina.ne.presentation.profile.ChangePasswordFragment"
        android:label="@string/change_password_title"
        tools:layout="@layout/fragment_change_password" />

    <!--
        Bloc Utilitaires (voir fragment_dashboard.xml, juste avant le bloc Budget) : raccourcis
        vers des fonctionnalités annexes. Catégories réutilise categoriesFragment ci-dessus, déjà
        déclaré — seules les 2 destinations suivantes sont nouvelles pour ce bloc.
    -->
    <fragment
        android:id="@+id/allUtilitiesFragment"
        android:name="com.arzikina.ne.presentation.utilities.AllUtilitiesFragment"
        android:label="@string/all_utilities_title"
        tools:layout="@layout/fragment_all_utilities" />

    <!--
        Écran principal Prêts/Emprunts (voir presentation/utilities/loans/LoansViewModel) :
        cartes de résumé + liste. id de destination et point d'entrée depuis le Dashboard/"Tous
        les utilitaires" inchangés depuis le placeholder initial.
    -->
    <fragment
        android:id="@+id/loansFragment"
        android:name="com.arzikina.ne.presentation.utilities.LoansFragment"
        android:label="@string/utility_loans_title"
        tools:layout="@layout/fragment_loans" />

    <!--
        Ajout d'un prêt/emprunt (voir presentation/utilities/loans/LoanFormFragment), atteint
        depuis le FAB/l'état vide de loansFragment. Toujours en création (pas d'argument
        `loanId` comme accountFormFragment) : l'édition n'est pas prévue à ce stade du plan de
        développement Prêts/Emprunts.
    -->
    <fragment
        android:id="@+id/loanFormFragment"
        android:name="com.arzikina.ne.presentation.utilities.loans.LoanFormFragment"
        android:label="@string/loan_form_title_step1"
        tools:layout="@layout/fragment_loan_form" />

    <!--
        Détail d'un prêt/emprunt (voir presentation/utilities/loans/LoanDetailFragment), atteint
        en cliquant sur une carte de loansFragment. loanId n'a volontairement PAS de valeur par
        défaut, même raisonnement que accountDetailFragment/accountId ci-dessus.
    -->
    <fragment
        android:id="@+id/loanDetailFragment"
        android:name="com.arzikina.ne.presentation.utilities.loans.LoanDetailFragment"
        android:label="@string/loan_detail_title"
        tools:layout="@layout/fragment_loan_detail">
        <argument
            android:name="loanId"
            app:argType="long" />
    </fragment>

    <!--
        Enregistrement d'un remboursement (voir presentation/utilities/loans/LoanPaymentFormFragment),
        atteint depuis le bouton "Enregistrer un remboursement" de loanDetailFragment. loanId
        obligatoire (même raisonnement que loanDetailFragment ci-dessus) : ce formulaire n'a de
        sens que rattaché à un prêt/emprunt précis.
    -->
    <fragment
        android:id="@+id/loanPaymentFormFragment"
        android:name="com.arzikina.ne.presentation.utilities.loans.LoanPaymentFormFragment"
        android:label="@string/loan_payment_form_title"
        tools:layout="@layout/fragment_loan_payment_form">
        <argument
            android:name="loanId"
            app:argType="long" />
    </fragment>

    <!--
        Statistiques Prêts/Emprunts (voir presentation/utilities/loans/LoanStatisticsFragment),
        atteint depuis l'action dédiée de la Toolbar de loansFragment. Pas d'argument : agrège
        l'ensemble des prêts/emprunts de l'utilisateur, même raisonnement que loanFormFragment
        ci-dessus (toujours la même vue, pas d'entité précise à cibler).
    -->
    <fragment
        android:id="@+id/loanStatisticsFragment"
        android:name="com.arzikina.ne.presentation.utilities.loans.LoanStatisticsFragment"
        android:label="@string/loan_statistics_title"
        tools:layout="@layout/fragment_loan_statistics" />

    <!--
        Première UI réelle pour BackupViewModel (voir presentation/settings/BackupFragment,
        présent depuis l'étape Sauvegarde en version Compose mais resté sans écran depuis la
        reconstruction XML/Views — voir settingsFragment ci-dessus, resté un simple placeholder).
    -->
    <fragment
        android:id="@+id/backupFragment"
        android:name="com.arzikina.ne.presentation.settings.BackupFragment"
        android:label="@string/utility_backup_title"
        tools:layout="@layout/fragment_backup" />

    <fragment
        android:id="@+id/securityQuestionFragment"
        android:name="com.arzikina.ne.presentation.profile.SecurityQuestionUpdateFragment"
        android:label="@string/update_security_question_title"
        tools:layout="@layout/fragment_security_question" />

</navigation>
