<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <!--
        Les 5 onglets de la Bottom Navigation. Les identifiants (@+id/...)
        correspondent exactement à ceux de menu/bottom_nav_menu.xml : c'est ce
        qui permet à NavigationUI.setupWithNavController de faire le lien
        automatiquement entre un item de menu sélectionné et sa destination.

        Les écrans secondaires (Comptes, Catégories, formulaires...) seront
        ajoutés comme destinations supplémentaires au fur et à mesure de leur
        reconversion en XML/Views, comme en Compose où ils étaient atteints
        depuis le Dashboard sans faire partie de la Bottom Navigation.
    -->

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.arzikina.ne.presentation.dashboard.DashboardFragment"
        android:label="@string/nav_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.arzikina.ne.presentation.transactions.TransactionsFragment"
        android:label="@string/nav_transactions"
        tools:layout="@layout/fragment_transactions" />

    <fragment
        android:id="@+id/transactionFormFragment"
        android:name="com.arzikina.ne.presentation.transactions.TransactionFormFragment"
        android:label="@string/transaction_form_title_add"
        tools:layout="@layout/fragment_transaction_form">
        <argument
            android:name="transactionId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.arzikina.ne.presentation.budget.BudgetFragment"
        android:label="@string/nav_budget"
        tools:layout="@layout/fragment_budget" />

    <fragment
        android:id="@+id/budgetFormFragment"
        android:name="com.arzikina.ne.presentation.budget.BudgetFormFragment"
        android:label="@string/budget_form_title_add"
        tools:layout="@layout/fragment_budget_form">
        <argument
            android:name="budgetId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.arzikina.ne.presentation.statistics.StatisticsFragment"
        android:label="@string/nav_statistics"
        tools:layout="@layout/fragment_statistics" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.arzikina.ne.presentation.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

    <!--
        Écrans secondaires, atteints depuis le Dashboard (pas dans la Bottom
        Navigation) : mêmes routes que sous Compose, reconstruites une à une.
    -->

    <fragment
        android:id="@+id/accountsFragment"
        android:name="com.arzikina.ne.presentation.accounts.AccountsFragment"
        android:label="@string/accounts_title"
        tools:layout="@layout/fragment_accounts" />

    <fragment
        android:id="@+id/accountFormFragment"
        android:name="com.arzikina.ne.presentation.accounts.AccountFormFragment"
        android:label="@string/account_form_title_add"
        tools:layout="@layout/fragment_account_form">
        <argument
            android:name="accountId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.arzikina.ne.presentation.categories.CategoriesFragment"
        android:label="@string/categories_title"
        tools:layout="@layout/fragment_categories" />

    <fragment
        android:id="@+id/categoryFormFragment"
        android:name="com.arzikina.ne.presentation.categories.CategoryFormFragment"
        android:label="@string/category_form_title_add"
        tools:layout="@layout/fragment_category_form">
        <argument
            android:name="categoryId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

</navigation>
