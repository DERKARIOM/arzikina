<?xml version="1.0" encoding="utf-8"?>
<!--
    Chemins exposés par le FileProvider (voir AndroidManifest.xml, util/Constants.FILE_PROVIDER_AUTHORITY_SUFFIX)
    — cahier des charges "Gestion des reçus", section 17/18, et "Gestion de la photo de profil" :
    stockage privé UNIQUEMENT, jamais le stockage public.

    `files-path` désigne `context.filesDir` : seuls les sous-dossiers `receipts/` (voir
    data/receipts/ReceiptFileStorage) et `profile_photos/` (voir data/profile/ProfilePhotoFileStorage)
    sont exposés, jamais l'intégralité de `filesDir` (ex. la base Room y vit aussi, voir
    Constants.DATABASE_NAME — ne doit jamais être accessible via une URI content://).
-->
<paths xmlns:android="http://schemas.android.com/apk/res-auto">
    <files-path
        name="receipts"
        path="receipts/" />
    <files-path
        name="profile_photos"
        path="profile_photos/" />
</paths>
