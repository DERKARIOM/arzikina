<?xml version="1.0" encoding="utf-8"?>
<!--
    Couleur de l'icône de chaque item de la Bottom Navigation, appliquée via
    app:itemIconTint sur la BottomNavigationView (activity_main.xml) : même icône
    dans les deux états (aucune forme/badge derrière), seule sa couleur change —
    couleur primaire (émeraude) quand l'item est sélectionné, couleur neutre discrète
    sinon. Les deux attributs référencés s'adaptent déjà automatiquement au thème
    clair/sombre.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:color="?attr/colorPrimary"
        android:state_checked="true" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
