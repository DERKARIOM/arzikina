<?xml version="1.0" encoding="utf-8"?>
<!--
    Texte du MaterialButtonToggleGroup Comptes/Cartes bancaires — voir
    toggle_button_background_selector.xml (même principe, couleur du texte plutôt que du fond) :
    sélectionné = blanc (lisible sur #42B998), non sélectionné = colorOnSurfaceVariant (adapté au
    thème, cohérent avec le fond discret associé).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@android:color/white" android:state_checked="true" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
