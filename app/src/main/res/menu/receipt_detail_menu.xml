<?xml version="1.0" encoding="utf-8"?>
<!--
    Actions de la Toolbar de "Détail du reçu" (voir ReceiptDetailFragment) — cahier des charges
    "Gestion des reçus", section 6 : renommer/supprimer. "Ouvrir"/"Partager" restent des boutons
    pleine largeur sous l'aperçu PDF (voir fragment_receipt_detail.xml), pas des actions de menu :
    ce sont les actions les plus fréquentes de cet écran, plus visibles ainsi. "action_delete_item"
    réutilise le même id que form_delete_menu.xml (même sémantique "Supprimer", pas de raison de
    diverger).
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_rename_receipt"
        android:icon="@drawable/ic_edit_24"
        android:title="@string/receipt_detail_rename_action"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_delete_item"
        android:icon="@drawable/ic_delete_24"
        android:title="@string/action_delete"
        app:showAsAction="always" />
</menu>
