    d'édition où seule la suppression a du sens.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_edit_account"
        android:icon="@drawable/ic_edit_24"
        android:title="@string/account_detail_menu_edit"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_delete_account"
        android:icon="@drawable/ic_delete_24"
        android:title="@string/account_detail_menu_delete"
        app:showAsAction="never" />
</menu>
