<?xml version="1.0" encoding="utf-8"?>
<!--
    Premier plan de l'icône adaptative Arzikina — carte bancaire inclinée en équilibre sur un
    pivot (fusion des pistes "carte" + "balance budgétaire" validées avec l'utilisateur).
    Viewport standard Android 108x108dp ; le glyphe est mis à l'échelle (0.6) et centré dans un
    groupe englobant pour rester dans la "safe zone" (~66dp) que tous les masques de lanceur
    (cercle, squircle, goutte...) laissent visible — voir la doc officielle des icônes adaptatives.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="24"
        android:translateY="24">
        <!-- Pivot / socle de la balance -->
        <path
            android:fillColor="#42B998"
            android:pathData="M40,80 L60,80 L50,60 Z" />
        <group
            android:pivotX="50"
            android:pivotY="47"
            android:rotation="-10">
            <!-- Corps de la carte (rectangle arrondi) -->
            <path
                android:fillColor="#42B998"
                android:pathData="M12,28 H88 A8,8 0 0 1 96,36 V58 A8,8 0 0 1 88,66 H12 A8,8 0 0 1 4,58 V36 A8,8 0 0 1 12,28 Z" />
            <!-- Bande magnétique -->
            <path
                android:fillColor="#1F9A78"
                android:pathData="M4,38 H96 V46 H4 Z" />
            <!-- Puce -->
            <path
                android:fillColor="#F0A63B"
                android:pathData="M18,50 H33 A2,2 0 0 1 35,52 V60 A2,2 0 0 1 33,62 H18 A2,2 0 0 1 16,60 V52 A2,2 0 0 1 18,50 Z" />
        </group>
    </group>
</vector>
