<?xml version="1.0" encoding="utf-8"?>
<!--
    Fond dégradé du PostCard "Montant disponible" de la liste des planifications
    (item_financial_plan.xml) : dégradé vert fixe du haut vers le bas (angle 270, voir
    android:angle sur GradientDrawable — 0=gauche→droite, sens antihoraire), posé comme fond du
    contenu à l'intérieur d'une MaterialCardView. Un simple rectangle suffit (pas de coins arrondis
    ici) : la MaterialCardView découpe déjà son contenu selon sa propre forme — même principe que
    item_account_credit_card.xml (voir AccountCardGradient pour le même raisonnement).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/arzikina_financial_plan_card_start"
        android:endColor="@color/arzikina_financial_plan_card_end" />
</shape>
