<?xml version="1.0" encoding="utf-8"?>
<!--
    Puce bancaire décorative (voir item_account_credit_card.xml) : simple
    rectangle arrondi semi-transparent, pas une texture réaliste — reste
    lisible sur n'importe quel dégradé de couleur choisi pour la carte
    (voir AccountCardGradient), sans dépendre d'une teinte or/argent fixe qui
    jurerait sur certaines couleurs.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#4DFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#80FFFFFF" />
    <corners android:radius="4dp" />
</shape>
