<?xml version="1.0" encoding="utf-8"?>
<!-- Tintée via `android:tint="?attr/colorControlNormal"` sur le vector — même pattern que TOUTES
     les autres icônes du bloc Utilitaires (investissement_24.xml, ic_receipt_long_24.xml,
     ic_planifications.xml...) : sans cet attribut, l'icône reste figée sur son fillColor brut
     (#FF000000 = noir), invisible sur fond sombre. Bug remonté par l'utilisateur (icône
     "Marketplace personnelle" noire en thème sombre, "Tous les utilitaires"). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:fillColor="#FF000000"
        android:pathData="M20,4L4,4v2h16L20,4zM21,14v-2l-1,-5L4,7l-1,5v2h1v6h10v-6h4v6h2v-6h1zM12,18L6,18v-4h6v4z" />
</vector>
