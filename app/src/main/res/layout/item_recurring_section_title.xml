<?xml version="1.0" encoding="utf-8"?>
<!--
    En-tête d'une section de l'écran "Transactions planifiées" ("À traiter"/"À venir"/"Historique",
    voir RecurringTransactionsListRow.SectionTitle) — même structure que la ligne titre+compte de
    item_loan_summary_header.xml (voir listCount), réutilisée ici pour chacune des 3 sections.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_l"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_m">

    <TextView
        android:id="@+id/sectionTitle"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/colorOnSurface"
        tools:text="À traiter" />

    <TextView
        android:id="@+id/sectionCount"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="3" />

</LinearLayout>
