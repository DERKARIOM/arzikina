<?xml version="1.0" encoding="utf-8"?>
<!--
    Premier élément de la liste de l'écran "Détail de la planification" (voir
    FinancialPlanDetailAdapter, même principe Header+Rows que item_loan_detail_header.xml) : carte
    "postcard" de résumé (icône/nom/disponible/prévu/reste/progression, même structure visuelle que
    item_financial_plan.xml de l'écran liste) puis le titre de la section "Dépenses prévues" — les
    dépenses elles-mêmes sont des items séparés (item_financial_plan_row.xml) suivant celui-ci.

    Couleurs de texte (?attr/colorOnSurface/colorOnSurfaceVariant, pas de blanc figé) : même
    convention que item_financial_plan.xml/item_budget.xml, pas item_loan_detail_header.xml (texte
    blanc figé, écran plus ancien) — cohérence à l'intérieur de la fonctionnalité Planification.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingTop="@dimen/spacing_m">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkable="false"
        app:cardBackgroundColor="@color/arzikina_postcart_background"
        app:cardCornerRadius="@dimen/corner_radius_medium"
        app:cardElevation="@dimen/elevation_raised">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_m">

            <ImageView
                android:id="@+id/planIcon"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_s"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/planName"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/planIcon"
                app:layout_constraintTop_toTopOf="@id/planIcon"
                tools:text="Mariage" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/amountsBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="availableValue,plannedValue" />

            <TextView
                android:id="@+id/availableLabel"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/financial_plan_available_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toStartOf="@id/plannedLabel"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/planIcon" />

            <TextView
                android:id="@+id/availableValue"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="@id/availableLabel"
                app:layout_constraintStart_toStartOf="@id/availableLabel"
                app:layout_constraintTop_toBottomOf="@id/availableLabel"
                tools:text="150 000 F CFA" />

            <TextView
                android:id="@+id/plannedLabel"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/financial_plan_planned_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/availableLabel"
                app:layout_constraintTop_toBottomOf="@id/planIcon" />

            <TextView
                android:id="@+id/plannedValue"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="@id/plannedLabel"
                app:layout_constraintStart_toStartOf="@id/plannedLabel"
                app:layout_constraintTop_toBottomOf="@id/plannedLabel"
                tools:text="92 500 F CFA" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/amountsBarrier"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp"
                app:trackColor="?attr/colorSurfaceVariant"
                tools:progress="62" />

            <TextView
                android:id="@+id/remainingLabel"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progressBar"
                tools:text="Reste : 57 500 F CFA" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/itemsSectionTitle"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:textColor="?attr/colorOnSurface"
        tools:text="Dépenses prévues (2)" />

    <TextView
        android:id="@+id/itemsEmptyText"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="@string/financial_plan_detail_items_empty"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
