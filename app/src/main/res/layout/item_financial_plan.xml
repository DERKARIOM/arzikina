<?xml version="1.0" encoding="utf-8"?>
<!--
    PostCard "Montant disponible" d'UNE planification — liste "Mes planifications"
    (FinancialPlansFragment) ET bloc "Mes planifications" du Dashboard (adapter partagé, voir
    FinancialPlansAdapter/showDeleteButton). Redesign sur capture de référence fournie par
    l'utilisateur : grande carte à coins très arrondis, fond en dégradé vert fixe (voir
    bg_financial_plan_card_gradient.xml), tous les textes en blanc, sans bordure — même technique
    de dégradé "posé dans une MaterialCardView qui découpe déjà son contenu" que
    item_account_credit_card.xml.

    Pas d'icône ni de bouton supprimer sur cette carte (absents de la capture) : la suppression
    reste possible depuis "Détail de la planification" (menu ⋮ > Supprimer) — un clic de plus, pas
    une perte de fonctionnalité. Le nom du plan est reporté sur la ligne du bas, au même alignement
    que le "% utilisé", pour rester identifiable dans une liste à plusieurs planifications sans
    surcharger le haut de carte (voir FinancialPlansAdapter.ViewHolder.bind, réutilisé tel quel
    par le bloc "Mes planifications" du Dashboard).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/planCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginTop="@dimen/spacing_m"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="15dp"
    app:cardElevation="@dimen/elevation_raised"
    app:rippleColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_financial_plan_card_gradient"
        android:padding="@dimen/spacing_l">

        <!-- A. Haut du card : libellé discret + grand montant, centrés. -->
        <TextView
            android:id="@+id/availableAmountLabel"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:gravity="center"
            android:text="@string/financial_plan_form_available_amount_label"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/availableValue"
            style="@style/TextAppearance.Material3.HeadlineMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textSize="25dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/availableAmountLabel"
            tools:text="150 000 F CFA" />

        <!-- B. Séparateur horizontal fin (~18% blanc, voir colors.xml). -->
        <View
            android:id="@+id/cardDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/arzikina_divider_on_financial_plan_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/availableValue" />

        <!-- C. Milieu du card, deux colonnes : Total prévu (gauche) / Reste (droite). -->
        <TextView
            android:id="@+id/plannedLabel"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:alpha="0.85"
            android:text="@string/financial_plan_card_total_label"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@id/remainingLabel"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardDivider" />

        <TextView
            android:id="@+id/plannedValue"
            style="@style/TextAppearance.Material3.TitleLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15dp"
            app:layout_constraintEnd_toEndOf="@id/plannedLabel"
            app:layout_constraintStart_toStartOf="@id/plannedLabel"
            app:layout_constraintTop_toBottomOf="@id/plannedLabel"
            tools:text="79 000 F CFA" />

        <TextView
            android:id="@+id/remainingLabel"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="@dimen/spacing_m"
            android:alpha="0.85"
            android:text="@string/financial_plan_card_remaining_label"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/plannedLabel"
            app:layout_constraintTop_toBottomOf="@id/cardDivider"
            tools:text="Reste" />

        <TextView
            android:id="@+id/remainingValue"
            style="@style/TextAppearance.Material3.TitleLarge"
            android:layout_width="0dp"
            android:gravity="end"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="15dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/remainingLabel"
            app:layout_constraintStart_toStartOf="@id/remainingLabel"
            app:layout_constraintTop_toBottomOf="@id/remainingLabel"
            tools:text="71 000 F CFA" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/columnsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="plannedValue,remainingValue" />

        <!-- D. Barre de progression : remplissage blanc plein, piste blanche ~28% (voir
             colors.xml), coins arrondis. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            app:indicatorColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/columnsBarrier"
            app:trackColor="@color/arzikina_track_on_financial_plan_card"
            app:trackCornerRadius="5dp"
            app:trackThickness="10dp"
            tools:progress="62" />

        <!-- E. Bas du card : nom de la planification (gauche) et "% utilisé" (droite), même
             alignement. -->
        <TextView
            android:id="@+id/planName"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@id/percentUsedLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            tools:text="Mariage" />

        <TextView
            android:id="@+id/percentUsedLabel"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:textColor="@color/white"
            app:layout_constraintBaseline_toBaselineOf="@id/planName"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="52 % utilisé" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
