<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/arzikina_postcart_background"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingVertical="@dimen/spacing_s">

    <ImageView
        android:id="@+id/planIcon"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="@null"
        android:padding="@dimen/spacing_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/planName"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toEndOf="@id/planIcon"
        app:layout_constraintTop_toTopOf="@id/planIcon"
        tools:text="Mariage" />

    <ImageButton
        android:id="@+id/deleteButton"
        android:layout_width="@dimen/icon_size_default"
        android:layout_height="@dimen/icon_size_default"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_delete"
        android:src="@drawable/ic_delete_24"
        app:layout_constraintBottom_toBottomOf="@id/planIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/planIcon" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/amountsBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="availableValue,plannedValue" />

    <TextView
        android:id="@+id/availableLabel"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:text="@string/financial_plan_available_label"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/plannedLabel"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/planIcon" />

    <TextView
        android:id="@+id/availableValue"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="@id/availableLabel"
        app:layout_constraintStart_toStartOf="@id/availableLabel"
        app:layout_constraintTop_toBottomOf="@id/availableLabel"
        tools:text="150 000 F CFA" />

    <TextView
        android:id="@+id/plannedLabel"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:text="@string/financial_plan_planned_label"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/availableLabel"
        app:layout_constraintTop_toBottomOf="@id/planIcon" />

    <TextView
        android:id="@+id/plannedValue"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="@id/plannedLabel"
        app:layout_constraintStart_toStartOf="@id/plannedLabel"
        app:layout_constraintTop_toBottomOf="@id/plannedLabel"
        tools:text="92 500 F CFA" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amountsBarrier"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp"
        app:trackColor="?attr/colorSurfaceVariant"
        tools:progress="62" />

    <TextView
        android:id="@+id/remainingLabel"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        tools:text="Reste : 57 500 F CFA" />

</androidx.constraintlayout.widget.ConstraintLayout>
