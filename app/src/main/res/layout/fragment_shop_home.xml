<?xml version="1.0" encoding="utf-8"?>
<!--
    Onglet Boutique (voir ShopFragment) : deux pages — Produits (affichée en premier) et Tableau de bord —
    hébergées comme fragments enfants dans shopPageContainer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/shopTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:tabGravity="fill"
        app:tabMode="fixed" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/shopPageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
