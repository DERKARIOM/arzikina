<?xml version="1.0" encoding="utf-8"?>
<!-- Contenu du dialogue "Renommer" (voir ReceiptDetailFragment.showRenameDialog) — champ clair
     standard (PAS le style "postcard" sombre de dialog_new_person.xml : ce dialogue Material
     n'a pas de fond sombre à raccorder). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_s">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/renameLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/receipt_detail_rename_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/renameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
