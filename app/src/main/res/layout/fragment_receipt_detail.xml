<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran "Détail du reçu" (voir presentation/utilities/receipts/ReceiptDetailFragment) — cahier des
    charges "Gestion des reçus", section 6 : aperçu de la page 1 du PDF (voir ReceiptPdfRenderer),
    Ouvrir/Partager (boutons pleine largeur, actions les plus fréquentes), Renommer/Supprimer
    (actions de la Toolbar, voir receipt_detail_menu.xml — même principe que loan_detail/
    financial_plan_detail : actions destructives/d'édition dans le menu, actions de consultation en
    boutons).

    PAS de RecyclerView ici (contrairement à fragment_loans.xml) : contenu à structure fixe pour un
    seul reçu, un simple NestedScrollView + LinearLayout suffit.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/receipt_detail_menu"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:titleTextColor="?attr/colorOnSurface"
        tools:title="Facture_electricite_aout.pdf" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s">

            <!-- ==================== Aperçu PDF (page 1) ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkable="false"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="0dp">

                <!-- Cliquable (voir ReceiptDetailFragment) : ouvre le visualiseur PDF plein écran
                     (cahier des charges section 7). Le clic reste sans effet tant qu'aucune page
                     n'est disponible (voir ReceiptDetailFragment.setUpPreviewClick) — rien à
                     visualiser en plein écran dans ce cas. -->
                <FrameLayout
                    android:id="@+id/previewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/previewImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Visible tant que ReceiptDetailViewModel.previewBitmap reste `null` (rendu en
                         cours OU définitivement indisponible, voir sa doc — pas de distinction visuelle
                         entre les deux, un aperçu manquant n'est de toute façon jamais bloquant : voir
                         les boutons Ouvrir/Partager, toujours actionnables). -->
                    <TextView
                        android:id="@+id/previewUnavailableText"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/receipt_detail_preview_unavailable"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== Ouvrir / Partager ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:layout_weight="1"
                    android:text="@string/receipt_detail_open_action"
                    app:icon="@drawable/ic_open_in_new_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/forme_radius_10dp"
                    android:text="@string/receipt_detail_share_action"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_share_24"
                    app:iconTint="@color/white" />

            </LinearLayout>

            <!-- ==================== Montant détecté (suggestion) ====================
                 Voir ReceiptDetailViewModel.suggestedAmountMinor : UNIQUEMENT une suggestion, jamais
                 un montant déjà enregistré (voir ReceiptAmountParser, "ne jamais inventer une
                 donnée") — visible seulement le temps que l'utilisateur confirme, modifie ou
                 ignore explicitement (voir ReceiptDetailFragment). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/suggestedAmountCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:checkable="false"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/receipt_detail_suggested_amount_title"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/suggestedAmountValue"
                        style="@style/TextAppearance.Material3.HeadlineSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textColor="?attr/colorPrimary"
                        tools:text="5 000 F CFA" />

                    <TextView
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/receipt_detail_suggested_amount_disclaimer"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/confirmSuggestedAmountButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:background="@drawable/forme_radius_10dp"
                        android:text="@string/receipt_detail_suggested_amount_confirm"
                        android:textColor="@color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editSuggestedAmountButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/receipt_detail_suggested_amount_edit" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dismissSuggestedAmountButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/receipt_detail_suggested_amount_dismiss" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== Informations ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:checkable="false"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/receipt_detail_info_title"
                        android:textColor="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/receipt_detail_received_label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/receivedValue"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="12 août 2026 · 15:41" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/receipt_detail_size_label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/sizeValue"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="2,3 Mo" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/receipt_detail_source_label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/sourceValue"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Orange Money" />

                    </LinearLayout>

                    <!-- Visible uniquement si Receipt.amountMinor est renseigné (voir
                         ReceiptDetailFragment.render) — toujours `null` dans cette première version. -->
                    <LinearLayout
                        android:id="@+id/amountRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/receipt_detail_amount_label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/amountValue"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="5 000 F CFA" />

                    </LinearLayout>

                    <!-- Voir ReceiptDetailViewModel.detectAmountButtonState (Hidden/Idle/Loading) :
                         visible SEULEMENT tant qu'aucun montant n'est enregistré (amountRow ci-dessus
                         masqué) et qu'aucune suggestion n'est déjà affichée par suggestedAmountCard —
                         jamais les deux en même temps. Déclenchement à la demande uniquement, jamais
                         automatique (voir cahier des charges, "extraction du montant"). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detectAmountButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:paddingHorizontal="0dp"
                        android:text="@string/receipt_detail_detect_amount_action"
                        android:visibility="gone"
                        app:icon="@drawable/ic_search_24"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
