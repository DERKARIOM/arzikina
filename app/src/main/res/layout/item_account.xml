<?xml version="1.0" encoding="utf-8"?>
<!--
    Carte de compte façon carte bancaire (voir maquette "RÉORGANISATION – PAGE
    COMPTE") : fond en dégradé calculé depuis Account.colorArgb (voir
    AccountsAdapter/AccountCardGradient, appliqué par code sur `cardContent` —
    un ConstraintLayout imbriqué, pas la MaterialCardView elle-même, qui ne
    supporte pas un `cardBackgroundColor` en dégradé). Toute la carte est
    cliquable et ouvre "Détail du compte" ; modifier/supprimer se fait depuis
    le menu "⋮" de cet écran (voir AccountDetailFragment) — pas de bouton
    dédié ici, comme sur la maquette.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/accountCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginTop="@dimen/spacing_m"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="@dimen/elevation_raised"
    app:rippleColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:padding="@dimen/spacing_l">

        <!--
            Motif discret ("fond avec dégradé et motifs subtils", voir
            maquette) : un simple cercle blanc semi-transparent qui déborde
            du cadre, découpé par la forme de la carte. Déclaré en premier
            pour rester sous le reste du contenu.
        -->
        <View
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="-60dp"
            android:layout_marginEnd="-40dp"
            android:alpha="0.10"
            android:background="@drawable/bg_icon_circle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!--
            Badge blanc opaque (contrairement aux icônes de transaction, qui
            reçoivent la couleur du compte en fond) : sur une carte déjà en
            dégradé coloré, c'est l'icône elle-même qui prend cette couleur
            (voir AccountsAdapter), pour rester lisible quel que soit le
            dégradé.
        -->
        <ImageView
            android:id="@+id/accountIcon"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@null"
            android:padding="@dimen/spacing_s"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            tools:tint="#3B82F6" />

        <TextView
            android:id="@+id/accountName"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/accountBalance"
            app:layout_constraintStart_toEndOf="@id/accountIcon"
            app:layout_constraintTop_toTopOf="@id/accountIcon"
            tools:text="Compte principal" />

        <TextView
            android:id="@+id/accountType"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="2dp"
            android:alpha="0.85"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toStartOf="@id/accountBalance"
            app:layout_constraintStart_toEndOf="@id/accountIcon"
            app:layout_constraintTop_toBottomOf="@id/accountName"
            tools:text="Banque" />

        <TextView
            android:id="@+id/accountBalance"
            style="@style/TextAppearance.Material3.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="150 000 F CFA" />

        <!--
            Indicateur discret "compte exclu des statistiques" (voir Account.isExcludedFromStatistics) :
            GONE par défaut, affiché juste devant le solde par AccountCardBinder — emplacement
            volontaire pour associer visuellement l'icône au chiffre qu'elle concerne, sans ajouter
            de bandeau ni toucher aux contraintes existantes d'accountBalance.
        -->
        <ImageView
            android:id="@+id/exclusionIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:alpha="0.85"
            android:contentDescription="@string/accounts_excluded_from_statistics_indicator"
            android:src="@drawable/ic_visibility_off_24"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/accountBalance"
            app:layout_constraintEnd_toStartOf="@id/accountBalance"
            app:layout_constraintTop_toTopOf="@id/accountBalance"
            app:tint="@android:color/white"
            tools:visibility="visible" />

        <!--
            Objectif d'épargne (AccountType.SAVINGS_GOAL) uniquement — GONE sinon, la carte d'un
            compte classique reste strictement identique. Rempli par AccountCardBinder : montant
            actuel / montant cible, pourcentage, barre de progression (blanche, lisible sur le
            dégradé de la couleur du compte, quelle qu'elle soit) et statut « atteint/dépassé ».
        -->
        <LinearLayout
            android:id="@+id/savingsGoalProgressGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/accountIcon"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/savingsGoalAmounts"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    tools:text="150 000 F / 500 000 F" />

                <TextView
                    android:id="@+id/savingsGoalPercent"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    tools:text="30 %" />

            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/savingsGoalProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:importantForAccessibility="no"
                android:max="100"
                app:indicatorColor="@android:color/white"
                app:trackColor="@color/savings_goal_track_on_card"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp"
                tools:progress="30" />

            <TextView
                android:id="@+id/savingsGoalStatus"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@android:color/white"
                android:visibility="gone"
                tools:text="Objectif atteint"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Sous l'icône, OU sous la progression d'objectif quand elle est visible (une Barrier
             ignore les vues GONE) : le badge ne chevauche jamais la barre. -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/contentBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="accountIcon,savingsGoalProgressGroup" />

        <TextView
            android:id="@+id/cardBadge"
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:alpha="0.9"
            android:letterSpacing="0.12"
            android:text="@string/accounts_card_badge"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contentBottomBarrier"
            app:layout_constraintVertical_bias="1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
