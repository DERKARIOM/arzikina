<?xml version="1.0" encoding="utf-8"?>
<!--
    Carte d'un objectif d'épargne (voir SavingsGoalsAdapter et la maquette, écran 1) : initiale,
    nom, puce d'échéance, menu ⋮, montants, progression, suggestion « ≈ X par mois ». Toucher la
    carte ouvre le panneau de versement (bottom_sheet_savings_contribution.xml).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/goalCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginTop="@dimen/spacing_s"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="@dimen/elevation_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/goalInitial"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:backgroundTint="@color/savings_avatar_bg"
                tools:text="T"
                tools:textColor="@color/savings_avatar_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/goalName"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Tabaski 2027" />

                <LinearLayout
                    android:id="@+id/deadlineChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@drawable/bg_savings_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_s"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:id="@+id/deadlineIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        tools:src="@drawable/ic_calendar_24" />

                    <TextView
                        android:id="@+id/deadlineText"
                        style="@style/TextAppearance.Material3.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        tools:text="16 mai 2027 · 234 jours restants" />

                </LinearLayout>

            </LinearLayout>

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/savings_goal_actions_content_description"
                android:src="@drawable/ic_more_horiz_24"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/savedValue"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="45 000 F CFA" />

            <TextView
                android:id="@+id/targetValue"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="sur 150 000 F CFA" />

            <TextView
                android:id="@+id/percentValue"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                tools:text="30 %" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/goalProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:importantForAccessibility="no"
            android:max="100"
            app:trackColor="?attr/colorOutlineVariant"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp"
            tools:progress="30" />

        <LinearLayout
            android:id="@+id/suggestionBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:background="@drawable/bg_savings_suggestion"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_s"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_up_right_24"
                app:tint="@color/savings_suggestion_text" />

            <TextView
                android:id="@+id/suggestionText"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:textColor="@color/savings_suggestion_text"
                tools:text="≈ 15 000 F CFA par mois pour tenir l'échéance" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
