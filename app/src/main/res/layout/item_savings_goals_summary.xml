<?xml version="1.0" encoding="utf-8"?>
<!-- Carte de synthèse de « Mes objectifs d'épargne » (voir SavingsGoalsSummary) : même fond sombre
     fixe que la carte Solde du Dashboard (@color/arzikina_balance_card). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginTop="@dimen/spacing_m"
    app:cardBackgroundColor="@color/arzikina_balance_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="@dimen/elevation_raised">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/savings_goals_summary_label"
            android:textColor="@color/arzikina_on_balance_card_variant" />

        <TextView
            android:id="@+id/totalSavedValue"
            style="@style/TextAppearance.Material3.HeadlineSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/arzikina_on_balance_card"
            android:textStyle="bold"
            tools:text="375 000 F CFA" />

        <TextView
            android:id="@+id/totalTargetValue"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/arzikina_on_balance_card_variant"
            tools:text="sur 1 220 000 F CFA visés" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/totalProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:max="100"
            app:indicatorColor="@color/arzikina_primary"
            app:trackColor="@color/savings_track_on_dark"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp"
            tools:progress="31" />

        <TextView
            android:id="@+id/summaryDetails"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:textColor="@color/arzikina_on_balance_card"
            tools:text="31 %  ·  4 objectifs  ·  1 atteint" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
