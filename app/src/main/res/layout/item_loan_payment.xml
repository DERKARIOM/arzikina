<?xml version="1.0" encoding="utf-8"?>
<!--
    Une ligne de la section "Versements" de l'écran "Détail du prêt/emprunt" — un [LoanPayment]
    réellement enregistré (voir la doc de LoanDetailUiState.payments, pas de ligne fictive
    "à venir"). Carte claire simple (pas "postcard" sombre) : ce n'est qu'une sous-liste au sein
    d'un écran déjà surmonté de la carte de résumé sombre, la distinguer visuellement évite une
    surcharge de cartes sombres empilées.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginTop="@dimen/spacing_s"
    android:checkable="false"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_m">

        <TextView
            android:id="@+id/paymentDate"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@id/paymentAmount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="3 juin 2025" />

        <TextView
            android:id="@+id/paymentAccountName"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@id/paymentAmount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/paymentDate"
            tools:text="Compte bancaire" />

        <!-- Masqué si LoanPayment.note est vide. -->
        <TextView
            android:id="@+id/paymentNote"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="italic"
            app:layout_constraintEnd_toStartOf="@id/paymentAmount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/paymentAccountName"
            tools:text="Premier versement" />

        <TextView
            android:id="@+id/paymentAmount"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/paymentDeleteButton"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="+50 000 F CFA"
            tools:textColor="#16A34A" />

        <!-- Suppression d'un versement (voir LoanDetailFragment.confirmDeletePayment) : icône
             discrète plutôt qu'un appui long, sans précédent dans l'app pour ce dernier — plus
             visible/découvrable, cohérent avec les icônes "⋮"/crayon utilisées ailleurs pour les
             actions destructrices. -->
        <ImageView
            android:id="@+id/paymentDeleteButton"
            android:layout_width="@dimen/icon_size_default"
            android:layout_height="@dimen/icon_size_default"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_delete"
            android:padding="2dp"
            android:src="@drawable/ic_delete_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurfaceVariant" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
