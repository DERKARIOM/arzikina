<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!--
        Titre dynamique (nom du compte, voir AccountDetailFragment.render) et
        menu "⋮" (Modifier/Supprimer, voir res/menu/account_detail_menu.xml) —
        remplace le clic-pour-éditer de l'ancien écran "Mes comptes".
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:titleTextColor="?attr/colorOnSurface"
        tools:title="Espèces" />

    <!--
        Résumé du compte, DEUX présentations mutuellement exclusives (voir
        AccountDetailFragment.render, qui bascule leur visibilité selon
        account.type) : la carte façon carte bancaire classique, comme sur
        "Mes comptes" (item_account.xml/AccountCardBinder), OU la carte
        virtuelle façon VISA pour AccountType.CREDIT_CARD
        (item_account_credit_card.xml/AccountCardCreditBinder) — incluses ici
        plutôt que recopiées, un seul layout à maintenir par présentation pour
        les deux écrans qui la montrent. Le view binding généré expose ces
        fragments de vue comme des `ItemAccountBinding`/`ItemAccountCreditCardBinding`
        nommés d'après leur id (binding.accountSummaryCard.*/accountSummaryCreditCard.*).
    -->
    <include
        android:id="@+id/accountSummaryCard"
        layout="@layout/item_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginHorizontal="@dimen/spacing_m"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <include
        android:id="@+id/accountSummaryCreditCard"
        layout="@layout/item_account_credit_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!--
        Se positionne juste sous celle des deux cartes ci-dessus qui est
        VISIBLE (une Barrier ignore les vues GONE) : évite de dupliquer la
        logique de bascule de visibilité dans les contraintes du reste de
        l'écran, qui n'a besoin de connaître que "sous le résumé", peu importe
        lequel.
    -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/summaryBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="accountSummaryCard,accountSummaryCreditCard" />

    <!--
        Mobile Money uniquement (voir AccountDetailFragment.renderMobileMoneyAppCard) : jamais
        visible en même temps que accountSummaryCreditCard (types mutuellement exclusifs), donc
        ancrée directement sous accountSummaryCard plutôt que summaryBarrier — pas d'ambiguïté à
        résoudre puisque accountSummaryCreditCard est TOUJOURS masquée quand ce compte s'affiche.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mobileMoneyAppCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
        android:visibility="gone"
        app:cardBackgroundColor="@color/arzikina_postcart_background"
        app:cardCornerRadius="@dimen/corner_radius_medium"
        app:cardElevation="@dimen/elevation_raised"
        app:layout_constraintTop_toBottomOf="@id/accountSummaryCard"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mobileMoneyAppIcon"
                    android:layout_width="@dimen/icon_size_large"
                    android:layout_height="@dimen/icon_size_large"
                    android:contentDescription="@null"
                    tools:src="@drawable/ic_account_mobile_money_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mobileMoneyAppLabel"
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Airtel Money" />

                    <TextView
                        android:id="@+id/mobileMoneyAppDescription"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="Le package com.exemple n'est associé à aucune application installée." />

                </LinearLayout>

                <!--
                    Reste sur la ligne icône + nom (au lieu d'occuper toute la largeur en dessous) :
                    hérite du gravity="center_vertical" du parent, donc s'aligne verticalement avec
                    le logo et le libellé de l'application. wrap_content au lieu de match_parent pour
                    ne pas écraser le reste de la ligne ; style IconButton car il n'y a plus la place
                    pour du texte complet ici.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobileMoneyAppActionButton"
                    android:layout_width="wrap_content"
                    android:background="@drawable/forme_radius_10dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    app:icon="@drawable/ic_open_in_new_24"
                    android:paddingStart="5dp"
                    android:textColor="@color/white"
                    app:iconPadding="0dp"
                    tools:text="@string/account_detail_mobile_money_configure_action" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!--
        Référence mobileMoneyAppCard EN PLUS de summaryBarrier (pas directement
        accountSummaryCard/accountSummaryCreditCard, déjà couverts par summaryBarrier).
        `barrierAllowsGoneWidgets="false"` est OBLIGATOIRE ici : son défaut (`true`) ferait quand
        même compter mobileMoneyAppCard dans le calcul même GONE (position "fantôme" à hauteur 0,
        mais toujours décalée de son propre layout_marginTop) — decalant cette Barrier de 16dp vers
        le bas pour TOUS les comptes non-Mobile-Money. Avec `false`, une vue GONE référencée est
        entièrement ignorée : cette Barrier retombe exactement sur summaryBarrier quand
        mobileMoneyAppCard est masquée — aucune régression de layout pour les autres types de
        compte.
    -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/contentTopBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="summaryBarrier,mobileMoneyAppCard" />

    <TextView
        android:id="@+id/emptyState"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_l"
        android:text="@string/account_detail_empty"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contentTopBarrier" />

    <!--
        Même traitement "postcard" par jour que l'écran Transactions (voir
        fragment_transactions.xml) : cohérence entre les deux écrans qui
        listent des transactions au long cours.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactionsList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contentTopBarrier"
        tools:listitem="@layout/item_transaction_compact" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addTransactionButton"
        android:layout_width="wrap_content"
        android:textColor="@color/white"
        app:iconTint="@color/white"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_m"
        android:text=""
        app:icon="@drawable/ic_add_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
