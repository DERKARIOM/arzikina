<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/arzikina_postcart_background"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingVertical="@dimen/spacing_s">

    <ImageView
        android:id="@+id/categoryIcon"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="@null"
        android:padding="@dimen/spacing_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/categoryName"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toEndOf="@id/categoryIcon"
        app:layout_constraintTop_toTopOf="@id/categoryIcon"
        tools:text="Nourriture" />

    <TextView
        android:id="@+id/periodLabel"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toEndOf="@id/categoryIcon"
        app:layout_constraintTop_toBottomOf="@id/categoryName"
        tools:text="Mensuel · 120 000 F CFA" />

    <ImageButton
        android:id="@+id/deleteButton"
        android:layout_width="@dimen/icon_size_default"
        android:layout_height="@dimen/icon_size_default"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_delete"
        android:src="@drawable/ic_delete_24"
        app:layout_constraintBottom_toBottomOf="@id/categoryIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/categoryIcon" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryIcon"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp"
        app:indicatorColor="@color/arzikina_primary"
        app:trackColor="?attr/colorSurfaceVariant"
        tools:progress="60" />

    <!-- Curseur "Aujourd'hui" (voir util/BudgetPace.kt + BudgetAdapter.bindTodayCursor) — même
         technique que item_budget_modern.xml (ligne + label repositionnés par `horizontalBias`),
         mais en couleur NEUTRE (colorOnSurface, ce card n'a pas de fond dégradé fixe) : c'est la
         couleur de la barre elle-même (voir indicatorColor défini par code) qui porte le rythme
         à jour/avance/dépassement, ce repère ne fait qu'indiquer LA POSITION du jour courant. -->
    <TextView
        android:id="@+id/todayCursorLabel"
        style="@style/TextAppearance.Material3.LabelSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_budget_card_chip"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:text="@string/budget_pace_today_cursor_label"
        android:textColor="?attr/colorOnSurface"
        android:textSize="9dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="@id/progressBar"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@id/progressBar" />

    <View
        android:id="@+id/todayCursorLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="@id/progressBar"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@id/progressBar"
        app:layout_constraintTop_toTopOf="@id/progressBar" />

    <!--
        Ligne "Expiration" : icône horloge + date de fin de la période en
        cours (voir DatePeriods.currentPeriodEnd, BudgetAdapter.kt). Couleur
        neutre par défaut, expense_red si la période se termine bientôt (voir
        BudgetAdapter.EXPIRATION_WARNING_THRESHOLD_DAYS).

        remainingLabel partage désormais cette même ligne (aligné sur
        expirationIcon en haut/bas, comme expirationLabel) et colle à
        l'extrémité droite (app:layout_constraintEnd_toEndOf="parent") au
        lieu d'être placé en dessous sur sa propre ligne.
    -->
    <ImageView
        android:id="@+id/expirationIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/spacing_xs"
        android:contentDescription="@null"
        android:src="@drawable/ic_time_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <TextView
        android:id="@+id/expirationLabel"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        app:layout_constraintBottom_toBottomOf="@id/expirationIcon"
        app:layout_constraintStart_toEndOf="@id/expirationIcon"
        app:layout_constraintTop_toTopOf="@id/expirationIcon"
        tools:text="Expire le 31 juil." />

    <TextView
        android:id="@+id/remainingLabel"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/expirationIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/expirationIcon"
        tools:text="Restant : 48 000 F CFA" />

</androidx.constraintlayout.widget.ConstraintLayout>