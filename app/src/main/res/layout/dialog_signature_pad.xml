<?xml version="1.0" encoding="utf-8"?>
<!--
    Contenu de la boîte de dialogue « Dessiner la signature » (voir IssuedReceiptFormFragment). Le cadre
    blanc rappelle le papier : la signature est toujours tracée sur fond clair, quel que soit le thème.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_s">

    <TextView
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/issued_receipt_signature_pad_hint"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="@dimen/spacing_s"
        android:background="@android:color/white">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="56dp"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:background="#33000000" />

        <com.naniger.arzikina.presentation.utilities.issuedreceipts.signature.SignaturePadView
            android:id="@+id/signaturePad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/issued_receipt_signature_pad_description" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signatureUndoButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/issued_receipt_signature_undo"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signatureClearButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_weight="1"
            android:text="@string/issued_receipt_signature_clear"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
