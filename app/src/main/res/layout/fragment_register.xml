<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran d'inscription (voir la feuille de route Authentification) — refonte visuelle (cahier des
    charges "Refonte Login/Register", inspirée de la maquette fournie), même principe que
    fragment_login.xml : en-tête réutilisable (item_auth_header.xml), champs postcard réutilisables
    (item_postcard_text_input.xml, personnalisés en code par RegisterFragment.setUpInputs — hint,
    icône, type de clavier), bouton plein-arrondi (Widget.Arzikina.Button.Pill).
    RegisterViewModel/RegisterFragment.kt conservent TOUS les champs existants (photo de profil,
    nom complet, nom d'utilisateur, e-mail, téléphone, mot de passe, confirmation, question/réponse
    de sécurité) — la maquette n'en montre qu'une partie, le reste est habillé dans le même langage
    visuel plutôt que supprimé (voir cahier des charges, "ne pas casser le fonctionnement actuel").

    Toolbar réduit à la seule flèche retour (pas de app:title) : le titre visuel de l'écran passe
    désormais par registerWelcomeTitle dans le contenu défilant, comme fragment_login.xml — même
    raisonnement que fragment_accounts.xml/fragment_settings.xml pour la absence de titre de
    Toolbar, ici la flèche retour reste nécessaire (Inscription est un écran poussé, pas un onglet).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_xl">

            <include
                android:id="@+id/authHeader"
                layout="@layout/item_auth_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/register_welcome_title"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                style="@style/TextAppearance.Material3.HeadlineMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/register_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                style="@style/TextAppearance.Material3.BodyMedium" />

            <!--
                Avatar circulaire (photo de profil, optionnelle) : image de remplacement
                (ic_person_24) tant qu'aucune photo n'est choisie, badge appareil photo superposé
                en bas à droite — inchangé fonctionnellement (voir RegisterFragment.kt,
                ActivityResultContracts.GetContent), la maquette ne montre pas ce champ mais il
                reste une fonctionnalité existante à conserver (cahier des charges section 12).
            -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_l"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@string/register_photo_action"
                    android:padding="@dimen/spacing_m"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person_24"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="?attr/colorPrimary"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_camera_24"
                    app:tint="?attr/colorOnPrimary" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/register_photo_action"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                style="@style/TextAppearance.Material3.LabelLarge" />

            <include
                android:id="@+id/fullNameField"
                layout="@layout/item_postcard_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l" />

            <include
                android:id="@+id/usernameField"
                layout="@layout/item_postcard_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m" />

            <include
                android:id="@+id/emailField"
                layout="@layout/item_postcard_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m" />

            <include
                android:id="@+id/phoneField"
                layout="@layout/item_postcard_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m" />

            <include
                android:id="@+id/passwordField"
                layout="@layout/item_postcard_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m" />

            <include
                android:id="@+id/confirmPasswordField"
                layout="@layout/item_postcard_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m" />

            <!--
                Question de sécurité : liste FERMÉE (voir domain/model/SecurityQuestion), pas de
                champ libre — même widget ExposedDropdownMenu que pour les listes de choix
                existantes. La Card mère reste déclarée ici (pas dans item_dropdown_field.xml, voir
                sa doc) : même principe que partout ailleurs dans le projet pour ce type de champ,
                non retouché par cette refonte.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/securityQuestionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <include
                    android:id="@+id/securityQuestionField"
                    layout="@layout/item_dropdown_field" />

            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/securityAnswerField"
                layout="@layout/item_postcard_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registerButton"
                    style="@style/Widget.Arzikina.Button.Pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/register_submit_action" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressIndicator"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="?attr/colorOnPrimary"
                    app:trackColor="@android:color/transparent" />

            </FrameLayout>

            <!-- Voir fragment_login.xml pour le raisonnement vertical + gravity="center_horizontal"
                 (au lieu d'une ligne horizontale) : même bloc "lien de bascule" en bas d'écran,
                 même correction. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_login_prompt"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    style="@style/TextAppearance.Material3.BodyMedium" />

                <TextView
                    android:id="@+id/loginActionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/spacing_xs"
                    android:text="@string/register_login_action"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    style="@style/TextAppearance.Material3.BodyMedium" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
