<?xml version="1.0" encoding="utf-8"?>
<!-- Contenu du petit dialogue "Nouvelle personne" (voir PersonPickerDialog). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_l"
    android:paddingTop="@dimen/spacing_s">

    <!-- Postcard — voir descriptionLayout de fragment_transaction_form.xml ("harmonisation des
         champs de saisie"). -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/newPersonNameCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
        app:cardBackgroundColor="@color/arzikina_postcart_background"
        app:cardCornerRadius="@dimen/corner_radius_medium"
        app:cardElevation="@dimen/elevation_raised">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/newPersonNameLayout"
            style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            android:hint="@string/loan_form_new_person_name_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/newPersonNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />

        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/newPersonPhoneCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
        app:cardBackgroundColor="@color/arzikina_postcart_background"
        app:cardCornerRadius="@dimen/corner_radius_medium"
        app:cardElevation="@dimen/elevation_raised">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/newPersonPhoneLayout"
            style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            android:hint="@string/loan_form_new_person_phone_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/newPersonPhoneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />

        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
