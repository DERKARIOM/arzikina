<?xml version="1.0" encoding="utf-8"?>
<!--
    En-tête de section jour : date complète + libellé relatif à gauche
    ("Aujourd'hui"/"Hier", masqué pour les jours plus anciens — voir
    GroupedTransactionsAdapter.HeaderViewHolder), total net de la journée à
    droite. Élément de liste à part entière (pas un header RecyclerView
    sticky) : plus simple, suffisant pour des listes qui restent courtes.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_m"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:background="@drawable/bg_postcard_top"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingTop="@dimen/spacing_s"
    android:paddingBottom="@dimen/spacing_xs">

    <TextView
        android:id="@+id/dayDate"
        style="@style/TextAppearance.Material3.LabelLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/dayTotal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="08/08/2026" />

    <TextView
        android:id="@+id/dayRelativeLabel"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/dayTotal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dayDate"
        tools:text="Aujourd'hui" />

    <TextView
        android:id="@+id/dayTotal"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="-300 F CFA"
        tools:textColor="@color/expense_red" />

</androidx.constraintlayout.widget.ConstraintLayout>
