<?xml version="1.0" encoding="utf-8"?>
<!--
    Refonte visuelle alignée sur fragment_transaction_form.xml : mêmes champs
    et comportements qu'avant (voir AccountFormFragment), simplement
    réorganisés en "postcards" sombres (MaterialCardView, fond
    @color/arzikina_postcart_background, ThemeOverlay.Arzikina.OnBalanceCard)
    plutôt qu'en TextInputLayout nus les uns sous les autres — pour une
    apparence cohérente avec le formulaire de transaction.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:titleCentered="true"
        app:titleTextColor="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:id="@+id/formFieldsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <!--
                Nom : postcard simple (même principe que descriptionCard sur
                fragment_transaction_form.xml) — style OutlinedBox conservé pour
                l'animation du label flottant, mais sans son propre contour
                (boxStrokeWidth=0) pour éviter un double cadre une fois posé sur
                le fond sombre de la carte.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nameCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_xs"
                    android:hint="@string/account_form_name_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                Type : menu déroulant fermé — voir item_dropdown_field.xml (composant partagé,
                "harmonisation des Spinner"). Le hint est fixé par code
                (AccountFormFragment.setUpTypeDropdown), voir la doc du composant.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/typeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <include
                    android:id="@+id/typeField"
                    layout="@layout/item_dropdown_field" />

            </com.google.android.material.card.MaterialCardView>

            <!--
                Apparence (icône + couleur) : même principe que categoryCard sur
                fragment_transaction_form.xml (label + sélecteur horizontal), les
                deux réunis dans une seule postcard plutôt que deux cartes
                séparées — ils forment un seul réglage visuel ("à quoi ressemble
                ce compte") aux yeux de l'utilisateur.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appearanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_form_icon_label"
                        android:textColor="?attr/colorOnSurface" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/iconPicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:overScrollMode="never" />

                    <TextView
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_l"
                        android:text="@string/account_form_color_label"
                        android:textColor="?attr/colorOnSurface" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/colorPicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:overScrollMode="never" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                Devise : même traitement que typeCard ci-dessus — voir item_dropdown_field.xml.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/currencyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <include
                    android:id="@+id/currencyField"
                    layout="@layout/item_dropdown_field" />

            </com.google.android.material.card.MaterialCardView>

            <!--
                Solde initial : même traitement que nameCard ci-dessus (OutlinedBox simple).
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/balanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/balanceLayout"
                    style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_xs"
                    android:hint="@string/account_form_balance_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/balanceInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                Exclure des statistiques : voir Account.isExcludedFromStatistics et
                PersonalStatistics (mécanisme centralisé de filtrage). OFF par défaut (voir
                AccountFormState). Icône d'info purement illustrative (pas de tooltip au clic,
                la description en dessous suffit à expliquer l'effet du réglage).
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/excludeFromStatisticsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="@dimen/spacing_s"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/account_form_exclude_statistics_label"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/excludeFromStatisticsSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint"/>

                    </LinearLayout>

                    <TextView
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/account_form_exclude_statistics_description"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                Carte de crédit : visible uniquement pour AccountType.CREDIT_CARD (voir
                AccountFormFragment.render). L'id creditCardFieldsGroup porte maintenant
                directement la postcard (auparavant sur le LinearLayout interne) : sa visibilité
                se pilote exactement de la même façon côté Kotlin (View.VISIBLE/View.GONE), aucun
                changement de comportement, seulement de conteneur visuel.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/creditCardFieldsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_form_card_section_label"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/cardNumberLayout"
                        style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:hint="@string/account_form_card_number_label"
                        app:helperTextEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/cardNumberInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="1234 5678 9012 3456"
                            android:inputType="number"
                            android:maxLength="19"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/cardExpiryLayout"
                            style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:layout_marginEnd="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:hint="@string/account_form_card_expiry_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/cardExpiryInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="MM/AA"
                                android:inputType="number"
                                android:maxLength="5"
                                android:maxLines="1" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/cardCvvLayout"
                            style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:layout_marginStart="@dimen/spacing_s"
                            android:layout_weight="1"
                            android:hint="@string/account_form_card_cvv_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/cardCvvInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberPassword"
                                android:maxLength="4"
                                android:maxLines="1" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                Mobile Money : visible uniquement pour AccountType.MOBILE_MONEY (voir
                AccountFormFragment.render, même principe que creditCardFieldsGroup ci-dessus).
                Package Android de l'application associée, saisi manuellement OU choisi via le
                sélecteur d'applications détectées (voir ExternalAppPickerDialog).
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mobileMoneyFieldsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_form_mobile_money_section_label"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/mobileMoneyPackageLayout"
                        style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:hint="@string/account_form_mobile_money_package_label"
                        app:helperTextEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/mobileMoneyPackageInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="com.exemple.mobilemoney"
                            android:inputType="text"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/account_form_mobile_money_package_description"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectMobileMoneyAppButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:text="@string/account_form_mobile_money_select_app_action" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                Bouton Enregistrer : style Material par défaut CONSERVÉ (pas
                @drawable/forme_radius_10dp comme sur fragment_transaction_form.xml — ce
                drawable est rempli avec @color/arzikina_background, blanc en thème clair,
                ce qui rendrait le texte blanc du bouton illisible ; voir le message envoyé à
                l'utilisateur, qui signale ce bug préexistant plutôt que de le reproduire ici).
                Pas de bouton Supprimer ici (déjà dans le menu "⋮" de la Toolbar, voir
                AccountFormFragment.setUpToolbar), contrairement au formulaire de transaction.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:background="@drawable/forme_radius_10dp"
                android:textColor="@color/white"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/action_save" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
