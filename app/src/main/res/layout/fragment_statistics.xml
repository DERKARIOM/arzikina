<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/nav_statistics"
        app:titleTextColor="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <!--
                Sélecteur de période (voir StatisticsViewModel.PeriodSelection) : menu déroulant
                "postcard" ExposedDropdownMenu — item_dropdown_field.xml, le "spinner moderne" déjà
                centralisé et utilisé partout ailleurs dans l'app (Type, Devise, Catégorie budget,
                filtres Transactions...), réutilisé tel quel plutôt qu'un nouveau composant (voir
                aussi categoryField de fragment_budget_form.xml pour le même pattern Card+include).
                Remplace le MaterialButtonToggleGroup du premier jet de ce chantier, jugé moins
                cohérent avec le reste de l'app qu'un Spinner Material3. Pilote les totaux ci-dessous
                ET la répartition par catégorie ("Répartition") ; le graphique "Évolution" plus bas
                reste volontairement indépendant (voir la doc de tête de StatisticsViewModel).
            -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <include
                    android:id="@+id/periodPresetField"
                    layout="@layout/item_dropdown_field" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Visible uniquement si "Personnalisée" est sélectionnée dans le Spinner ci-dessus
                 (voir StatisticsFragment.render) — même Card/include que startDateRow/endDateRow de
                 fragment_budget_form.xml. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/customStartRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <include
                    android:id="@+id/customStartField"
                    layout="@layout/item_date_field" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/customEndRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <include
                    android:id="@+id/customEndField"
                    layout="@layout/item_date_field" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/periodErrorText"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:textColor="@color/expense_red"
                android:visibility="gone"
                tools:text="La date de début doit être antérieure ou égale à la date de fin." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetPeriodButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/statistics_period_reset"
                android:textColor="@color/arzikina_primary" />

            <!--
                Totaux Revenus/Dépenses/Solde de la période sélectionnée — nouveauté de ce chantier
                (l'écran n'affichait auparavant aucun total, voir StatisticsViewModel). Même style de
                Card que balanceCard/fragment_dashboard.xml (arzikina_postcart_background), pour
                rester cohérent avec les autres écrans plutôt que d'inventer un nouveau style de
                carte de statistiques.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/totalsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                app:cardBackgroundColor="@color/arzikina_balance_card"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/arzikina_postcart_background"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/statistics_total_income_label"
                            android:textColor="@color/arzikina_on_balance_card_variant" />

                        <TextView
                            android:id="@+id/totalIncomeValue"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textColor="@color/income_green"
                            tools:text="0 F CFA" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/arzikina_on_balance_card_variant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/statistics_total_expense_label"
                            android:textColor="@color/arzikina_on_balance_card_variant" />

                        <TextView
                            android:id="@+id/totalExpenseValue"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textColor="@color/expense_red"
                            tools:text="0 F CFA" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/arzikina_on_balance_card_variant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/statistics_total_balance_label"
                            android:textColor="@color/arzikina_on_balance_card_variant" />

                        <TextView
                            android:id="@+id/totalNetValue"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textColor="@color/arzikina_on_balance_card"
                            tools:text="0 F CFA" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--
                Section "Répartition" englobée dans un conteneur dédié : bascule d'un seul bloc en
                GONE quand periodError != null (voir StatisticsFragment.render), plutôt que de gérer
                la visibilité de chacune de ses 4 vues séparément. Placée AVANT "Évolution" (ordre
                inversé sur demande explicite) : c'est elle qui dépend de la période sélectionnée
                ci-dessus, contrairement à "Évolution" qui reste fixe sur 6 mois — l'ordre de lecture
                suit maintenant celui du sélecteur de période.
            -->
            <LinearLayout
                android:id="@+id/breakdownSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="@string/statistics_breakdown_title"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Spinner Dépenses/Revenus (voir StatisticsViewModel.BreakdownType) — même
                     composant "postcard" ExposedDropdownMenu que le Spinner de période plus haut. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                    app:cardBackgroundColor="@color/arzikina_postcart_background"
                    app:cardCornerRadius="@dimen/corner_radius_medium"
                    app:cardElevation="@dimen/elevation_raised">

                    <include
                        android:id="@+id/breakdownTypeField"
                        layout="@layout/item_dropdown_field" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/breakdownEmptyState"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Aucune dépense sur la période sélectionnée." />

                <!-- Diagramme en bâtons (une couleur par catégorie, voir CategoryBarChartView) —
                     remplace l'ancien anneau CategoryPieView sur demande explicite, à la manière du
                     graphique équivalent de la version Web. Pleine largeur (contrairement à l'anneau,
                     qui était carré) : un graphique en barres a besoin de place horizontale pour
                     rester lisible avec jusqu'à 8 catégories. -->
                <com.arzikina.ne.presentation.statistics.CategoryBarChartView
                    android:id="@+id/breakdownChart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="@dimen/spacing_s" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/breakdownLegendList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/statistics_evolution_title"
                android:textColor="?attr/colorOnSurface" />

            <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                android:id="@+id/evolutionChart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="@dimen/spacing_s"
                app:chartStyle="@style/EvolutionChartStyle" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/income_green" />

                <TextView
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_m"
                    android:text="@string/statistics_legend_income"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/expense_red" />

                <TextView
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:text="@string/statistics_legend_expense"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
