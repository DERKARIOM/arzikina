<?xml version="1.0" encoding="utf-8"?>
<!--
    Une ligne de la section "Dépenses prévues" de l'écran "Détail de la planification" — une
    FinancialPlanItem. Restylée pour former, avec les autres lignes, un seul bloc "postcard" sombre
    à couleur uniforme (voir FinancialPlanDetailAdapter.ItemViewHolder.bind) — même principe visuel
    que item_transaction_compact.xml/GroupedTransactionsAdapter (fond uni entre les lignes, coins
    arrondis uniquement sur la première/dernière ligne du bloc, séparateur fin en haut de chaque
    ligne plutôt qu'une carte individuelle par dépense).

    PAS de MaterialCardView ici (contrairement à la version précédente, une carte claire par
    dépense) : le fond "postcard" (@color/arzikina_postcart_background, bg_postcard_top/_bottom/
    _single selon la position) est posé par code, exactement comme
    GroupedTransactionsAdapter.TransactionViewHolder.bind — ce layout n'étant pas partagé avec un
    autre écran (contrairement à item_transaction_compact.xml), la marge horizontale peut en
    revanche rester fixée ici, en dur.

    Icône catégorie en carré arrondi (bg_icon_rounded_square, comme item_transaction_compact.xml,
    plutôt que le cercle précédent) : alignement visuel volontaire sur le style "moderne" des listes
    de transactions.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingVertical="@dimen/spacing_s">

    <!-- Séparateur fin en haut de CHAQUE ligne (même principe que item_transaction_compact.xml) :
         couvre "entre deux dépenses" sans logique de position dans l'adapter ; masqué sur la
         toute première ligne du bloc (voir ItemViewHolder.bind) pour ne pas dupliquer l'arrondi du
         haut du bloc. -->
    <View
        android:id="@+id/itemDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.15"
        android:background="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/itemCategoryIcon"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:layout_marginTop="@dimen/spacing_s"
        android:background="@drawable/bg_icon_rounded_square"
        android:contentDescription="@null"
        android:padding="@dimen/spacing_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/itemDivider"
        app:tint="@android:color/white"
        tools:tint="@android:color/white" />

    <TextView
        android:id="@+id/itemName"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/itemAmount"
        app:layout_constraintStart_toEndOf="@id/itemCategoryIcon"
        app:layout_constraintTop_toTopOf="@id/itemCategoryIcon"
        tools:text="Alliance" />

    <TextView
        android:id="@+id/itemAmount"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/itemConvertedIcon"
        app:layout_constraintTop_toTopOf="@id/itemCategoryIcon"
        tools:text="35 000 F CFA" />

    <!-- Visible uniquement si FinancialPlanItem.transactionId n'est pas nul (voir
         FinancialPlanDetailAdapter.ItemViewHolder.bind, Étape 6) : indique que cette dépense
         prévue a déjà été convertie en transaction réelle. -->
    <ImageView
        android:id="@+id/itemConvertedIcon"
        android:layout_width="@dimen/icon_size_default"
        android:layout_height="@dimen/icon_size_default"
        android:layout_marginStart="@dimen/spacing_xs"
        android:contentDescription="@string/financial_plan_item_converted_indicator"
        android:padding="2dp"
        android:src="@drawable/ic_receipt_long_24"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/itemDeleteButton"
        app:layout_constraintTop_toTopOf="@id/itemCategoryIcon"
        app:tint="?attr/colorOnSurfaceVariant"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/itemDeleteButton"
        android:layout_width="@dimen/icon_size_default"
        android:layout_height="@dimen/icon_size_default"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_delete"
        android:padding="2dp"
        android:src="@drawable/ic_delete_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/itemCategoryIcon"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/itemStatusPill"
        style="@style/TextAppearance.Material3.LabelSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="@dimen/spacing_s"
        android:paddingVertical="2dp"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toEndOf="@id/itemCategoryIcon"
        app:layout_constraintTop_toBottomOf="@id/itemName"
        tools:backgroundTint="#8E938F"
        tools:text="À prévoir" />

    <TextView
        android:id="@+id/itemPriorityLabel"
        style="@style/TextAppearance.Material3.LabelSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_s"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/itemStatusPill"
        app:layout_constraintStart_toEndOf="@id/itemStatusPill"
        app:layout_constraintTop_toTopOf="@id/itemStatusPill"
        tools:text="Essentielle"
        tools:textColor="#DC2626" />

    <TextView
        android:id="@+id/itemDateLabel"
        style="@style/TextAppearance.Material3.LabelSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_s"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="@id/itemStatusPill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/itemPriorityLabel"
        app:layout_constraintTop_toTopOf="@id/itemStatusPill"
        tools:text="12 mai 2025"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/itemDescription"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_xs"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/itemCategoryIcon"
        app:layout_constraintTop_toBottomOf="@id/itemStatusPill"
        tools:text="Prévoir la gravure des initiales."
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
