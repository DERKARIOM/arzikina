<?xml version="1.0" encoding="utf-8"?>
<!--
    Ligne du dialogue de sélection de catégorie (voir CategoryPickerDialog), utilisé par le
    formulaire de dépense prévue (Planification). Même structure que item_account_picker.xml sans
    la ligne "solde" (une catégorie n'a pas de solde) — icône teintée + nom seulement.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingVertical="@dimen/spacing_s">

    <ImageView
        android:id="@+id/categoryIcon"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="@null"
        android:padding="@dimen/spacing_s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/categoryName"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="@id/categoryIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/categoryIcon"
        app:layout_constraintTop_toTopOf="@id/categoryIcon"
        tools:text="Alimentation" />

</androidx.constraintlayout.widget.ConstraintLayout>
