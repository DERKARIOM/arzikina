<?xml version="1.0" encoding="utf-8"?>
<!--
    Ligne du panier de vente (voir SaleCartAdapter) : nom, prix unitaire, montant de la ligne,
    commandes − / quantité / + et suppression. Postcard sombre fixe, comme les autres cartes du module.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_s"
    android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
    app:cardBackgroundColor="@color/arzikina_postcart_background"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="@dimen/elevation_raised">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_m">

        <TextView
            android:id="@+id/lineName"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/arzikina_on_balance_card"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/lineRemove"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sucre en poudre 1 kg" />

        <ImageButton
            android:id="@+id/lineRemove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/shop_cart_remove"
            android:src="@drawable/ic_delete_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/arzikina_on_balance_card_variant" />

        <TextView
            android:id="@+id/lineUnitPrice"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:textColor="@color/arzikina_on_balance_card_variant"
            app:layout_constraintEnd_toStartOf="@id/lineRemove"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lineName"
            tools:text="1 200 F CFA / pce" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lineMinus"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/spacing_s"
            android:contentDescription="@string/shop_cart_decrease"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−"
            android:textColor="@color/arzikina_on_balance_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lineUnitPrice" />

        <TextView
            android:id="@+id/lineQuantity"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/shop_cart_edit_quantity"
            android:gravity="center"
            android:textColor="@color/arzikina_on_balance_card"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/lineMinus"
            app:layout_constraintStart_toEndOf="@id/lineMinus"
            app:layout_constraintTop_toTopOf="@id/lineMinus"
            tools:text="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/linePlus"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/shop_cart_increase"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/arzikina_on_balance_card"
            app:layout_constraintStart_toEndOf="@id/lineQuantity"
            app:layout_constraintTop_toTopOf="@id/lineMinus" />

        <TextView
            android:id="@+id/lineTotal"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/arzikina_on_balance_card"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/lineMinus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/lineMinus"
            tools:text="2 400 F CFA" />

        <TextView
            android:id="@+id/lineProblem"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:textColor="@color/shop_stock_out"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/lineMinus"
            tools:text="Stock disponible : 1 pce"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
