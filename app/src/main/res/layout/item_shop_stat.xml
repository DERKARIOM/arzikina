<?xml version="1.0" encoding="utf-8"?>
<!--
    Carte d'indicateur du tableau de bord Boutique (valeur + libellé). Postcard fixe comme les autres
    cartes de l'app. La couleur de la valeur est posée par code (état de stock).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/statCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
    app:cardBackgroundColor="@color/arzikina_postcart_background"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="@dimen/elevation_raised">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <TextView
            android:id="@+id/statValue"
            style="@style/TextAppearance.Material3.HeadlineSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/arzikina_on_balance_card"
            android:textStyle="bold"
            tools:text="128" />

        <TextView
            android:id="@+id/statLabel"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/arzikina_on_balance_card_variant"
            tools:text="Produits" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
