<?xml version="1.0" encoding="utf-8"?>
<!--
    Ligne du dialogue de sélection de modèle (voir TemplatePickerDialog), ouvert depuis le
    formulaire de transaction (cahier des charges "Marketplace personnelle", extension "Choisir un
    modèle depuis l'ajout de transaction"). Même structure que item_account_picker.xml (icône
    teintée, titre, sous-titre) — icône/couleur de CATÉGORIE ici (pas de compte, le compte reste
    celui du formulaire, voir TransactionFormViewModel.applyTemplate).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingVertical="@dimen/spacing_s">

    <ImageView
        android:id="@+id/templatePickerIcon"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="@null"
        android:padding="@dimen/spacing_s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/templatePickerName"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/templatePickerIcon"
        app:layout_constraintTop_toTopOf="@id/templatePickerIcon"
        tools:text="Déjeuner" />

    <TextView
        android:id="@+id/templatePickerSubtitle"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/templatePickerIcon"
        app:layout_constraintTop_toBottomOf="@id/templatePickerName"
        tools:text="Alimentation · 2 000 F CFA" />

</androidx.constraintlayout.widget.ConstraintLayout>
