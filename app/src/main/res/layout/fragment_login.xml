<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran de Connexion : point d'entrée de l'app tant qu'aucune session
    locale n'existe (voir MainActivity.resolveStartDestination). Pas de
    MaterialToolbar ni de flèche retour ici — il n'y a nulle part où
    revenir, contrairement à Inscription qui, elle, est ouverte DEPUIS cet
    écran.

    Refonte visuelle (cahier des charges "Refonte Login/Register", inspirée de la maquette
    fournie) : en-tête réutilisable (item_auth_header.xml), champs postcard réutilisables
    (item_postcard_text_input.xml, personnalisés en code par LoginFragment.setUpInputs — hint,
    icône, type de clavier), bouton plein-arrondi (Widget.Arzikina.Button.Pill). LoginViewModel
    et sa logique (validation, LoginStage, gestion des erreurs) restent INCHANGÉS — seuls les ids
    exposés à LoginFragment.kt changent (passage par les `<include>` ci-dessous), voir sa KDoc.

    Alignement à GAUCHE (pas centré) pour le bloc en-tête/titre/champs, comme la maquette — seule
    la ligne "Créer un compte" tout en bas reste centrée (voir son layout_gravity dédié) :
    contrairement à l'ancienne version, ce conteneur n'a plus de `android:gravity="center_horizontal"`
    global.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_xl">

            <include
                android:id="@+id/authHeader"
                layout="@layout/item_auth_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/welcomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/login_welcome_title"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                style="@style/TextAppearance.Material3.HeadlineMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/login_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                style="@style/TextAppearance.Material3.BodyMedium" />

            <include
                android:id="@+id/identifierField"
                layout="@layout/item_postcard_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl" />

            <include
                android:id="@+id/passwordField"
                layout="@layout/item_postcard_text_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m" />

            <TextView
                android:id="@+id/forgotPasswordActionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/spacing_xs"
                android:text="@string/login_forgot_password_action"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                style="@style/TextAppearance.Material3.BodySmall" />

            <!--
                Erreur générique (identifiant OU mot de passe incorrect) : ne
                pointe volontairement aucun des deux champs (voir la KDoc de
                login_error_invalid_credentials dans strings.xml).
            -->
            <TextView
                android:id="@+id/formErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:gravity="center_horizontal"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                style="@style/TextAppearance.Material3.BodySmall"
                tools:ignore="SelectableText"
                tools:text="Identifiant ou mot de passe incorrect" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    style="@style/Widget.Arzikina.Button.Pill"
                    android:textColor="@color/white"
                    app:iconTint="@color/white"
                    android:background="@drawable/forme_radius_10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_submit_action" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressIndicator"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="?attr/colorOnPrimary"
                    app:trackColor="@android:color/transparent" />

            </FrameLayout>

            <!--
                Message d'étape (LoginViewModel.LoginStage) pendant/après la connexion —
                "Connexion…", "Synchronisation de vos données…", "✓ Synchronisation terminée"...
                Couleur neutre (contrairement à formErrorText, réservé aux erreurs).
            -->
            <TextView
                android:id="@+id/stageMessageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:gravity="center_horizontal"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                style="@style/TextAppearance.Material3.BodySmall"
                tools:ignore="SelectableText"
                tools:text="Synchronisation de vos données…" />

            <!--
                Vertical + gravity="center_horizontal" (pas horizontal côte à côte) : "Créer un
                compte" sur sa propre ligne, sous la question — les deux textes centrés
                indépendamment plutôt qu'une seule ligne qui forçait un retour à la ligne peu
                lisible une fois traduite ("Vous n'avez pas encore de compte ? Créer un compte").
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_register_prompt"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    style="@style/TextAppearance.Material3.BodyMedium" />

                <TextView
                    android:id="@+id/registerActionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/spacing_xs"
                    android:text="@string/login_register_action"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    style="@style/TextAppearance.Material3.BodyMedium" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
