<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Pas de app:navigationIcon (flèche retour) : Comptes est désormais l'onglet
         "Compte" de la Bottom Navigation, un écran de premier niveau, pas un écran
         secondaire atteint par navigation empilée. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/accounts_title"
        app:titleTextColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/emptyState"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_l"
        android:text="@string/accounts_empty_message"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Solde total (une seule ligne, en devise principale — voir
        AccountsViewModel.AccountsUiState, demande explicite plutôt qu'une
        ligne par devise comme sur le Dashboard). Même style de carte que la
        carte Solde du Dashboard (@color/arzikina_balance_card, voir
        colors.xml) : pas de nouvelle couleur "à part" pour cet écran, cette
        palette sombre fixe est déjà la convention de l'app pour les cartes
        de synthèse financière.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/totalBalanceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_m"
        app:cardBackgroundColor="@color/arzikina_balance_card"
        app:cardCornerRadius="@dimen/corner_radius_large"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/arzikina_postcart_background"
            android:padding="@dimen/spacing_l">

            <TextView
                android:id="@+id/totalBalanceLabel"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/accounts_balance_total_label"
                android:textColor="@color/arzikina_on_balance_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/totalBalanceValue"
                style="@style/TextAppearance.Material3.HeadlineMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/arzikina_on_balance_card"
                app:layout_constraintEnd_toStartOf="@id/toggleTotalBalanceVisibility"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/totalBalanceLabel"
                tools:text="471 461 F CFA" />

            <ImageButton
                android:id="@+id/toggleTotalBalanceVisibility"
                android:layout_width="@dimen/icon_size_default"
                android:layout_height="@dimen/icon_size_default"
                android:layout_marginStart="@dimen/spacing_s"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/accounts_balance_hide_action"
                android:src="@drawable/ic_visibility_24"
                app:layout_constraintBottom_toBottomOf="@id/totalBalanceValue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/totalBalanceValue"
                app:tint="@color/arzikina_on_balance_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/accountsList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/totalBalanceCard"
        tools:listitem="@layout/item_account" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addAccountButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_m"
        android:text="@string/accounts_add"
        app:icon="@drawable/ic_add_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
