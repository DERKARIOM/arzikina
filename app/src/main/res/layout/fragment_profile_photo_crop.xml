<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran « Recadrer la photo » (voir presentation/profile/crop/ProfilePhotoCropFragment).
    Fond noir derrière la photo : même convention que les éditeurs photo du système, la photo reste
    lisible en thème clair comme en thème sombre. Réglages du recadrage portés par les attributs
    app:crop* (cadre carré fixe, grille, zoom à deux doigts, sans rotation ni miroir).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/profile_photo_crop_menu"
        app:navigationContentDescription="@string/action_cancel"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/profile_photo_crop_title"
        app:titleTextColor="?attr/colorOnSurface" />

    <com.canhub.cropper.CropImageView
        android:id="@+id/cropImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/profile_photo_crop_area_description"
        app:cropAspectRatioX="1"
        app:cropAspectRatioY="1"
        app:cropAutoZoomEnabled="true"
        app:cropFixAspectRatio="true"
        app:cropGuidelines="on"
        app:cropMultiTouchEnabled="true"
        app:cropShape="rectangle"
        app:cropShowProgressBar="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="@id/cropImageView"
        app:layout_constraintEnd_toEndOf="@id/cropImageView"
        app:layout_constraintStart_toStartOf="@id/cropImageView"
        app:layout_constraintTop_toTopOf="@id/cropImageView" />

</androidx.constraintlayout.widget.ConstraintLayout>
