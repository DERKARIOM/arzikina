<?xml version="1.0" encoding="utf-8"?>
<!--
    Refonte visuelle (voir maquette "PERSONNALISATION – AJOUT DE TRANSACTION") :
    même ensemble de champs et de comportements qu'avant, réorganisés en
    cartes/lignes cliquables plutôt qu'en menus déroulants classiques. Pas de
    type "Transfert" ici (chantier séparé : nouveau concept de domaine, deux
    comptes, migration Room) ni de dictée vocale / scan de reçu (nécessitent
    des permissions micro/caméra et des bibliothèques dédiées) — reportés à
    des étapes ultérieures dédiées.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!--
        app:titleCentered aligne le titre sur la maquette ("Nouvelle
        transaction" centré) ; action rapide "✓" en plus du bouton
        "Enregistrer la transaction" en bas (voir transaction_form_menu.xml).
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:titleCentered="true"
        app:titleTextColor="?attr/colorOnSurface"
        app:iconTint="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <!--
                Transaction générée automatiquement par un prêt/emprunt (voir la doc de
                TransactionFormViewModel.TransactionFormState.linkedLoanId) : bannière cliquable
                redirigeant vers "Détail du prêt/emprunt" plutôt que de laisser modifier/supprimer
                cette transaction ici, ce qui désynchroniserait le montant remboursé/restant affiché
                là-bas. Masquée (GONE) dans tous les autres cas, la grande majorité des transactions.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loanLinkedBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_m"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/warning_amber"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/loanLinkedBannerText"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_m"
                    android:text="@string/transaction_form_loan_linked_banner"
                    android:textColor="@android:color/white" />

            </com.google.android.material.card.MaterialCardView>

            <!--
                Préremplissage depuis un reçu PDF (cahier des charges "Créer une transaction
                depuis un reçu", voir TransactionFormViewModel.applyReceiptPresets) : purement
                informative (pas cliquable, contrairement à loanLinkedBanner ci-dessus) —
                affichée UNIQUEMENT à la création, quand ce formulaire a été ouvert depuis
                "Détail du reçu". Même style que suggestedAmountCard sur fragment_receipt_detail.xml
                (colorSurfaceVariant) pour rester cohérent avec l'autre bannière de suggestion du
                projet, plutôt que la couleur d'alerte de loanLinkedBanner (pas un avertissement ici).
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/receiptPrefillBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_m"
                android:checkable="false"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_m"
                    android:text="@string/transaction_form_receipt_prefill_banner"
                    android:textColor="?attr/colorOnSurface" />

            </com.google.android.material.card.MaterialCardView>

            <!--
                Type sous forme de menu déroulant fermé (voir
                TransactionFormFragment.setUpTypeDropdown), plus compact que
                l'ancien sélecteur à deux boutons — et prêt à accueillir un
                3e choix "Transfert" (voir TransactionFormViewModel, chantier
                séparé) sans changer ce widget. Pas de couleur par type ici
                (rouge/vert) : ce serait redondant avec la carte Montant et le
                bouton Enregistrer, qui portent déjà cette couleur.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/typeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <include
                    android:id="@+id/typeField"
                    layout="@layout/item_dropdown_field" />

            </com.google.android.material.card.MaterialCardView>

            <!--
                Montant : grand et coloré (rouge/vert selon le type, voir
                TransactionFormFragment.render), raccourcis rapides qui
                s'AJOUTENT à la valeur déjà saisie plutôt que de la remplacer
                (voir TransactionFormViewModel.onQuickAmountAdd). Devise en
                lecture seule (celle du compte choisi) : la faire éditer
                indépendamment demanderait de découpler le montant de la
                devise du compte, une évolution d'architecture à part.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/amountCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        android:id="@+id/amountLabel"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/transaction_form_amount_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintEnd_toStartOf="@id/amountCurrencyBadge"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/amountCurrencyBadge"
                        style="@style/TextAppearance.Material3.LabelLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:background="@drawable/bg_chip_on_balance_card"
                        android:paddingHorizontal="@dimen/spacing_s"
                        android:paddingVertical="4dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="F CFA" />

                    <EditText
                        android:id="@+id/amountInput"
                        style="@style/TextAppearance.Material3.HeadlineMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:background="@null"
                        android:hint="0"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/amountLabel"
                        tools:text="12 500" />

                    <TextView
                        android:id="@+id/amountErrorText"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/expense_red"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/amountInput"
                        tools:text="Montant invalide"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:visibility="gone"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/amountErrorText">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quickAmount1Button"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            tools:text="+1 000" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quickAmount2Button"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            tools:text="+5 000" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quickAmount3Button"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            tools:text="+10 000" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                Frais supplémentaires (cahier des charges "Gestion des frais supplémentaires sur
                les transactions") : Switch qui révèle une postcard, même principe que
                endDateSwitch/endDateCard sur fragment_recurring_transaction_form.xml.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/transaction_form_add_fee_toggle"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/addFeeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/switch_thumb_tint"
                    app:trackTint="@color/switch_track_tint" />

            </LinearLayout>

            <!--
                Montant des frais, type, description, et résumé Montant/Frais/Total(ou Revenu net)
                — voir TransactionFormFragment.renderFeeSummary pour le calcul dynamique. Masquée
                tant que addFeeSwitch n'est pas activé.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/feeDetailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/feeAmountLayout"
                        style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/transaction_form_fee_amount_label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/feeAmountInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/feeAmountErrorText"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/expense_red"
                        android:visibility="gone"
                        tools:text="Montant des frais invalide"
                        tools:visibility="visible" />

                    <include
                        android:id="@+id/feeTypeField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        layout="@layout/item_dropdown_field" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/feeDescriptionLayout"
                        style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:hint="@string/transaction_form_fee_description_label">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/feeDescriptionInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLines="2" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Résumé dynamique (voir point 2 du cahier des charges) : recalculé à
                         chaque frappe sur le montant ou les frais (TransactionFormFragment.render). -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:alpha="0.15"
                        android:background="?attr/colorOnSurface" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/transaction_form_fee_summary_amount_label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/feeSummaryAmountValue"
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="50 000 F CFA" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/transaction_form_fee_summary_fee_label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/feeSummaryFeeValue"
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="500 F CFA" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/feeSummaryTotalLabel"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="@string/transaction_form_fee_summary_total_label" />

                        <TextView
                            android:id="@+id/feeSummaryTotalValue"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="50 500 F CFA" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                Compte utilisé pour les frais : même composant que accountRow/destinationAccountRow
                (item_account_field.xml), par défaut le compte source (voir
                TransactionFormViewModel.onHasFeeToggle/onAccountChange).
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/feeAccountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised"
                tools:visibility="visible">

                <include
                    android:id="@+id/feeAccountField"
                    layout="@layout/item_account_field" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/feeAccountErrorText"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/expense_red"
                android:visibility="gone"
                tools:text="Choisis un compte pour les frais"
                tools:visibility="visible" />

            <!--
                Catégorie : grille au lieu d'un menu déroulant. "Voir tout"
                bascule entre les catégories les plus courantes et la liste
                complète, purement local à l'écran (voir
                TransactionFormFragment.isCategoryGridExpanded) — pas un
                nouvel écran de sélection à part.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/categoryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/categoryLabel"
                            style="@style/TextAppearance.Material3.TitleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/transaction_form_category_label"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/categorySeeAllToggle"
                            style="@style/TextAppearance.Material3.LabelLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:drawableEnd="@drawable/ic_chevron_right_24"
                            android:gravity="center_vertical"
                            android:padding="@dimen/spacing_xs"
                            android:text="@string/transaction_form_category_see_all"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/categoryGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_s"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="4"
                        tools:itemCount="8"
                        tools:listitem="@layout/item_category_quick_pick" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/categoryErrorText"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/expense_red"
                android:visibility="gone"
                tools:text="Choisis une catégorie"
                tools:visibility="visible" />

            <!--
                Compte (source, pour un transfert) : ligne cliquable (icône,
                nom, solde courant) plutôt qu'un menu déroulant, ouvre
                AccountPickerDialog. Le solde affiché vient de
                TransactionFormViewModel.accountBalances (voir
                com.arzikina.ne.presentation.accounts.computeCurrentBalances),
                pas de Account.initialBalance. Contenu factorisé dans
                item_account_field.xml (voir ce fichier) : réutilisé tel quel
                pour la ligne "Compte destination" ci-dessous.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <include
                    android:id="@+id/accountField"
                    layout="@layout/item_account_field" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/accountErrorText"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/expense_red"
                android:visibility="gone"
                tools:text="Choisis un compte"
                tools:visibility="visible" />

            <!--
                Compte destination : uniquement pour un transfert (voir
                TransactionType.TRANSFER), GONE sinon (voir
                TransactionFormFragment.renderDestinationAccountRow). Même
                structure que la ligne "Compte" ci-dessus (item_account_field.xml),
                dont seul le libellé diffère ("Compte destination", écrasé par
                code dans onViewCreated).
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/destinationAccountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised"
                tools:visibility="visible">

                <include
                    android:id="@+id/destinationAccountField"
                    layout="@layout/item_account_field" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/destinationAccountErrorText"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/expense_red"
                android:visibility="gone"
                tools:text="Choisis un compte de destination"
                tools:visibility="visible" />

            <!--
                Date et heure : une seule ligne (voir maquette), le clic
                enchaîne le sélecteur de date puis celui de l'heure (voir
                TransactionFormFragment.showDatePicker) au lieu de deux champs
                séparés.
            -->
            <!-- Voir item_date_field.xml ("harmonisation des champs de saisie") : hint fixé par
                 code (TransactionFormFragment). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dateTimeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <include
                    android:id="@+id/dateTimeField"
                    layout="@layout/item_date_field" />

            </com.google.android.material.card.MaterialCardView>

            <!--
                Postcard sombre comme les autres blocs (voir amountCard/
                accountRow/dateTimeRow) : le champ garde son style
                OutlinedBox pour l'animation du label flottant, mais sans son
                propre contour (boxStrokeWidth=0) pour éviter un double cadre
                "boîte dans la boîte" une fois posé sur le fond sombre.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/descriptionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/descriptionLayout"
                    style="@style/Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_xs"
                    android:hint="@string/transaction_form_description_label"
                    app:startIconDrawable="@drawable/ic_label_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/descriptionInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="3" />

                </com.google.android.material.textfield.TextInputLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
                Lien inverse Reçu→Transaction (cahier des charges "Créer une transaction depuis un
                reçu", voir TransactionFormState.receiptId) : visible UNIQUEMENT en modification,
                quand la transaction chargée est déjà liée à un reçu (voir
                TransactionFormViewModel.init, isEditMode) — ouvre "Détail du reçu" (voir
                TransactionFormFragment.navigateToLinkedReceipt). Jamais affiché à la création : un
                reçu n'est associé qu'une fois la transaction réellement enregistrée (voir
                ReceiptDetailViewModel.onAddTransactionClicked, anti-doublon).
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/linkedReceiptRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                android:visibility="gone"
                app:cardBackgroundColor="@color/arzikina_postcart_background"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_raised"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_receipt_long_24"
                    android:drawableEnd="@drawable/ic_chevron_right_24"
                    android:drawablePadding="@dimen/spacing_m"
                    android:drawableTint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_m"
                    android:text="@string/transaction_form_linked_receipt_label"
                    android:textColor="?attr/colorOnSurface" />

            </com.google.android.material.card.MaterialCardView>

            <!--
                Repliable (voir TransactionFormFragment.setUpMoreDetailsToggle) :
                seul le moyen de paiement s'y trouve pour l'instant, prêt à
                accueillir d'autres champs optionnels plus tard sans changer
                cette structure.
            -->
            <TextView
                android:id="@+id/moreDetailsToggle"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:background="?attr/selectableItemBackground"
                android:drawableEnd="@drawable/ic_chevron_right_24"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_s"
                android:text="@string/transaction_form_more_details"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/moreDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!--
                    Optionnel ("si applicable") : liste fermée avec un premier
                    choix "Non précisé" qui remet le champ à `null` (voir
                    TransactionFormFragment.setUpDropdowns). Postcard — voir
                    item_dropdown_field.xml ("harmonisation des Spinner") : auparavant seul champ
                    déroulant nu (sans carte) de cet écran.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/paymentMethodCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:theme="@style/ThemeOverlay.Arzikina.OnBalanceCard"
                    app:cardBackgroundColor="@color/arzikina_postcart_background"
                    app:cardCornerRadius="@dimen/corner_radius_medium"
                    app:cardElevation="@dimen/elevation_raised">

                    <include
                        android:id="@+id/paymentMethodField"
                        layout="@layout/item_dropdown_field" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!--
                deleteButton n'apparaît qu'en modification (voir
                TransactionFormFragment.setUpToolbar — pas de transaction à
                supprimer en création). GONE plutôt que "layout_weight=0" :
                saveButton (poids 1) récupère alors toute la largeur, comme
                avant l'ajout de ce bouton. saveButton est teinté rouge/vert
                selon le type (voir TransactionFormFragment.render).
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/spacing_l"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:layout_weight="1"
                    android:text="@string/action_delete"
                    android:textColor="@color/expense_red"
                    android:visibility="gone"
                    app:cornerRadius="@dimen/corner_radius_extra_large"
                    app:strokeColor="@color/expense_red"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textColor="@color/white"
                    android:background="@drawable/forme_radius_10dp"
                    android:layout_weight="1"
                    android:text="@string/transaction_form_save_action"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
