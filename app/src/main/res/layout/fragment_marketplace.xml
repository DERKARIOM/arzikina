<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran "Marketplace personnelle" (voir presentation/utilities/marketplace/MarketplaceFragment,
    cahier des charges du même nom). Même structure que fragment_receipts.xml/fragment_loans.xml
    (recherche instantanée + panneau de filtres masqué par défaut, RecyclerView + FAB, état vide
    dédié) — cohérence entre les écrans "utilitaires" qui listent des éléments avec
    recherche/filtres. Différence : le ChipGroup de filtres (categoryChipGroup) est VIDE ici, rempli
    dynamiquement par catégorie (voir MarketplaceFragment.setUpCategoryChips) — contrairement aux
    chips fixes de fragment_receipts.xml.

    Ajoute des états chargement/erreur (voir loadingState/errorState) — cahier des charges section
    13 : contrairement à la plupart des écrans "utilitaires" de l'app (dont le résultat Room est
    quasi instantané), demandés explicitement ici.

    Atteint depuis le bloc Utilitaires (voir UtilityCatalog), section Utilitaires — cahier des
    charges section 12.

    Bouton "+"/état vide : ouvrent le formulaire de création (voir
    MarketplaceFragment.navigateToForm). Bouton "Acheter" de chaque Card : ouvre
    TransactionFormFragment pré-rempli (voir MarketplaceFragment.onBuyClicked).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/marketplace_menu"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/utility_marketplace_title"
        app:titleTextColor="?attr/colorOnSurface" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_s"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/corner_radius_medium"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            android:hint="@string/marketplace_search_placeholder"
            app:boxStrokeWidth="0dp"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/filtersPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_m">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <!-- Rempli dynamiquement (voir MarketplaceFragment.setUpCategoryChips) : "Toutes" +
                     une Chip par catégorie utilisée par au moins un modèle (voir
                     MarketplaceViewModel.categoryFilterOptions). -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categoryChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetFiltersButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/spacing_s"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@string/transactions_filters_reset"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/templatesList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filtersPanel"
        tools:listitem="@layout/item_marketplace_template" />

    <!-- État chargement (cahier des charges section 13) : Room répond quasi instantanément en
         pratique, affiché malgré tout le temps d'une première émission. -->
    <ProgressBar
        android:id="@+id/loadingState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filtersPanel"
        tools:visibility="visible" />

    <!-- État erreur (cahier des charges section 13) — ne devrait jamais se produire en pratique
         (lecture Room locale), mais demandé explicitement : voir MarketplaceFragment.render. -->
    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="gone">

        <ImageView
            android:layout_width="@dimen/icon_size_xlarge"
            android:layout_height="@dimen/icon_size_xlarge"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:src="@drawable/ic_error_outline_24"
            app:tint="@color/expense_red" />

        <TextView
            android:id="@+id/errorMessage"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Erreur inconnue" />

    </LinearLayout>

    <!-- FAB icône seule, même convention que fragment_loans.xml/fragment_receipts.xml. Voir la doc
         de tête : pas encore branché sur le formulaire de création (étape suivante). -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addTemplateButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_m"
        android:contentDescription="@string/marketplace_add_action"
        android:text=""
        app:icon="@drawable/ic_add_24"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- État vide (voir cahier des charges section 13) : remplace la liste ET le FAB tant qu'aucun
         modèle n'existe — même structure que fragment_receipts.xml/emptyState. -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible">

        <ImageView
            android:layout_width="@dimen/icon_size_xlarge"
            android:layout_height="@dimen/icon_size_xlarge"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:src="@drawable/ic_storefront_24"
            app:tint="?attr/colorPrimary" />

        <TextView
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:gravity="center"
            android:text="@string/marketplace_empty_title"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:text="@string/marketplace_empty_message"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyAddTemplateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:background="@drawable/forme_radius_10dp"
            android:text="@string/marketplace_add_action"
            android:textColor="@color/white"
            app:icon="@drawable/ic_add_24" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
