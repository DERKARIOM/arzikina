<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Échelle d'espacement, réutilisée dans tous les layouts pour éviter les
         valeurs magiques dispersées (voir instructions projet). -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_s">10dp</dimen>
    <dimen name="spacing_m">16dp</dimen>
    <dimen name="spacing_l">24dp</dimen>
    <dimen name="spacing_xl">32dp</dimen>

    <!-- Échelle de coins arrondis (miroir des ShapeAppearance.Arzikina.* de themes.xml,
         utile quand un composant a besoin d'un rayon en dur, ex. un CardView imbriqué). -->
    <dimen name="corner_radius_extra_small">8dp</dimen>
    <dimen name="corner_radius_small">12dp</dimen>
    <dimen name="corner_radius_medium">16dp</dimen>
    <dimen name="corner_radius_large">10dp</dimen>
    <dimen name="corner_radius_extra_large">32dp</dimen>

    <!-- Icônes -->
    <dimen name="icon_size_bottom_nav">26dp</dimen>
    <dimen name="icon_size_default">24dp</dimen>
    <dimen name="icon_size_large">40dp</dimen>
    <!-- Grande icône décorative des écrans "placeholder" (voir fragment_loans.xml). -->
    <dimen name="icon_size_xlarge">64dp</dimen>

    <!-- Largeur fixe d'une tuile du bloc Utilitaires (voir item_utility_tile.xml) : garantit un
         alignement régulier en défilement horizontal (Dashboard) ET en grille ("Tous les
         utilitaires"), et un retour à la ligne du titre prévisible sur petit écran. -->
    <dimen name="utility_tile_width">84dp</dimen>

    <!-- Élévation -->
    <dimen name="elevation_card">1dp</dimen>
    <dimen name="elevation_raised">3dp</dimen>

    <!-- Taille du libellé de la Bottom Navigation (voir TextAppearance.Arzikina.BottomNavigation.*,
         themes.xml) : légèrement réduite par rapport à la taille par défaut de Material3, pour
         rester discrète sous l'icône, mais un peu plus grande qu'avant (11sp/10sp) — plus lisible
         maintenant que la Bottom Navigation ne compte plus que 4 onglets (voir bottom_nav_menu.xml),
         avec un peu plus d'espace disponible par item. -->
    <dimen name="text_size_bottom_nav_active">13sp</dimen>
    <dimen name="text_size_bottom_nav_inactive">12sp</dimen>
</resources>
