<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Palette de marque Arzikina — vert émeraude, déclinée en rôles Material 3
        (thème clair). La variante sombre est dans values-night/colors.xml : les
        noms de ressources sont identiques, seules les valeurs changent, ce qui
        permet à themes.xml de rester unique pour les deux modes.
    -->

    <!-- Émeraude (couleur principale) -->
    <color name="arzikina_primary">#42B998</color>
    <color name="arzikina_on_primary">#FFFFFFFF</color>
    <color name="arzikina_primary_container">#42B998</color>
    <color name="arzikina_on_primary_container">#42B998</color>

    <!-- Vert clair (accent secondaire) -->
    <color name="arzikina_secondary">#42B998</color>
    <color name="arzikina_on_secondary">#FFFFFFFF</color>
    <color name="arzikina_secondary_container">#42B998</color>
    <color name="arzikina_on_secondary_container">#42B998</color>

    <!-- Tertiaire -->
    <color name="arzikina_tertiary">#42B998</color>
    <color name="arzikina_on_tertiary">#FFFFFFFF</color>

    <!-- Neutres -->
    <color name="arzikina_background">#FFFFFFFF</color>
    <color name="arzikina_on_background">#2B3940</color>
    <color name="arzikina_postcart_background">#191F2C</color>
    <color name="arzikina_surface">#FFFFFFFF</color>
    <color name="arzikina_on_surface">#2B3940</color>
    <color name="arzikina_surface_variant">#FFF5F7F6</color>
    <color name="arzikina_on_surface_variant">#2B3940</color>
    <color name="arzikina_outline">#FF8E938F</color>

    <!-- Erreur -->
    <color name="arzikina_error">#FFBA1A1A</color>
    <color name="arzikina_on_error">#FFFFFFFF</color>
    <color name="arzikina_error_container">#FFFFDAD6</color>
    <color name="arzikina_on_error_container">#FF410002</color>

    <!-- Couleurs sémantiques (revenus/dépenses/alertes), identiques dans les deux modes -->
    <color name="income_green">#42B998</color>
    <color name="expense_red">#FFDC2626</color>
    <color name="warning_amber">#FFF59E0B</color>

    <!--
        Carte Solde du Dashboard (fragment_dashboard.xml) : couleur fixe,
        volontairement identique en clair et en sombre (pas de valeur dans
        values-night/colors.xml — Android retombe alors sur celle-ci dans les
        deux modes), sur demande explicite pour correspondre à une image de
        référence. Contrairement aux autres rôles de cette palette, ce n'est
        pas un rôle Material 3 (colorPrimaryContainer etc.) : cette carte est
        pensée comme un élément visuel "à part", pas comme une déclinaison du
        thème.
    -->
    <color name="arzikina_balance_card">#1E293B</color>
    <color name="arzikina_on_balance_card">#FFFFFFFF</color>
    <!-- Libellés discrets sur ces cartes sombres fixes (ex. "Revenu", "Dépense"). -->
    <color name="arzikina_on_balance_card_variant">#FF94A3B8</color>
    <!-- Ligne de séparation entre transactions (voir divider_on_balance_card.xml) : même
         teinte que ci-dessus mais très transparente, pour rester à peine visible. -->
    <color name="arzikina_divider_on_balance_card">#1F94A3B8</color>

    <!--
        En-tête du Dashboard (avatar + salutation, voir bg_dashboard_header.xml) :
        couleurs fixes, volontairement identiques en clair et en sombre (même
        raisonnement que arzikina_balance_card ci-dessus). Dérivées du vert
        sarcelle du compte par défaut "Banque" (0xFF006C4F, voir DefaultAccounts.seed)
        par la même méthode que AccountCardGradient (teinte conservée, seule la
        composante V du HSV varie) — sur demande explicite, remplace l'ancien
        dégradé brun/ambré. Choix FIXE (comme avant) et non lié en direct au
        compte "Banque" : si l'utilisateur renomme/recolore ce compte plus
        tard, cet en-tête ne change pas tout seul — à réévaluer si ce lien
        doit un jour devenir dynamique. Seconde famille de couleurs de l'app,
        cantonnée à cet élément visuel précis, au même titre que la carte
        Solde n'appartient pas non plus à la palette émeraude/bleu-gris du
        reste du thème.
    -->
    <color name="arzikina_dashboard_header_dark">#001B14</color>
    <color name="arzikina_dashboard_header_glow">#008C67</color>
    <color name="arzikina_on_dashboard_header">#FFFFFFFF</color>
    <color name="white">#FFFFFFFF</color>
    <color name="arzikina_on_dashboard_header_variant">#CEE6E0</color>

    <!--
        Prêts/Emprunts (voir presentation/utilities/loans) : vert/rouge IDENTIQUES aux catégories
        par défaut de cette fonctionnalité (voir data/local/database/DefaultCategories, 0xFF16A34A /
        @color/expense_red = 0xFFDC2626) — pas @color/income_green (teal, couleur d'action générale
        de l'app) pour rester visuellement cohérent au sein de cette seule fonctionnalité. Les
        boutons/FAB de cet écran réutilisent en revanche ?attr/colorPrimary comme partout ailleurs
        dans Arzikina (décision explicite, pas la couleur violette de la maquette d'origine).
    -->
    <color name="loan_lent_color">#FF16A34A</color>
    <!-- Fond des cartes de résumé (voir item_loan_summary_header.xml) : mêmes teintes que
         ci-dessus mais très assombries, pour rester lisibles en carte "postcard" sombre. -->
    <color name="loan_summary_lent_bg">#1B3226</color>
    <color name="loan_summary_borrowed_bg">#3A1E1E</color>

    <!--
        PostCard "Montant disponible" de la liste des planifications (voir item_financial_plan.xml/
        bg_financial_plan_card_gradient.xml) : dégradé vert fixe, volontairement identique en clair
        et en sombre (même raisonnement que arzikina_balance_card ci-dessus) — carte "à part", pas
        une déclinaison du thème, sur demande explicite pour correspondre à une capture de
        référence.
    -->
    <color name="arzikina_financial_plan_card_start">#FF3CC28F</color>
    <color name="arzikina_financial_plan_card_end">#FF1AA978</color>
    <!-- Séparateur horizontal fin sur ce dégradé (~18% blanc). -->
    <color name="arzikina_divider_on_financial_plan_card">#2EFFFFFF</color>
    <!-- Piste (partie non remplie) de la barre de progression sur ce dégradé (~28% blanc) — la
         partie remplie reste @color/white plein. -->
    <color name="arzikina_track_on_financial_plan_card">#47FFFFFF</color>
</resources>
