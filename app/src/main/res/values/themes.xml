<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Thème racine Arzikina — Material Components sur Views (pas de Jetpack
        Compose, voir instructions projet), basé sur Theme.Material3.DayNight :
        le parent bascule automatiquement entre les rôles clairs/sombres selon
        le système, tandis que les valeurs elles-mêmes viennent de colors.xml /
        values-night/colors.xml. Le réglage manuel (Système/Clair/Sombre) choisi
        dans l'écran Paramètres est appliqué par-dessus via
        AppCompatDelegate.setDefaultNightMode (voir MainActivity).
    -->
    <style name="Theme.Arzikina" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Émeraude (couleur principale) -->
        <item name="colorPrimary">@color/arzikina_primary</item>
        <item name="colorOnPrimary">@color/arzikina_on_primary</item>
        <item name="colorPrimaryContainer">@color/arzikina_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/arzikina_on_primary_container</item>

        <!-- Vert clair (accent secondaire) -->
        <item name="colorSecondary">@color/arzikina_secondary</item>
        <item name="colorOnSecondary">@color/arzikina_on_secondary</item>
        <item name="colorSecondaryContainer">@color/arzikina_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/arzikina_on_secondary_container</item>

        <!-- Tertiaire -->
        <item name="colorTertiary">@color/arzikina_tertiary</item>
        <item name="colorOnTertiary">@color/arzikina_on_tertiary</item>

        <!-- Neutres -->
        <item name="android:colorBackground">@color/arzikina_background</item>
        <item name="colorOnBackground">@color/arzikina_on_background</item>
        <item name="colorSurface">@color/arzikina_surface</item>
        <item name="colorOnSurface">@color/arzikina_on_surface</item>
        <!--
            Alignée sur colorSurface plutôt que laissée à la valeur par défaut
            de Theme.Material3.DayNight (un ton légèrement différent) : ce
            rôle M3 est utilisé par défaut par plusieurs composants
            "surfaces élevées" (BottomNavigationView, BottomSheet, Card...)
            pour leur fond. La Bottom Navigation elle-même est en plus fixée
            explicitement (voir activity_main.xml, android:background +
            app:backgroundTint) : cet alignement de thème est une sécurité
            pour les composants futurs qui s'appuieraient sur ce rôle sans
            override explicite.
        -->
        <item name="colorSurfaceContainer">@color/arzikina_surface</item>
        <item name="colorSurfaceVariant">@color/arzikina_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/arzikina_on_surface_variant</item>
        <item name="colorOutline">@color/arzikina_outline</item>

        <!-- Erreur -->
        <item name="colorError">@color/arzikina_error</item>
        <item name="colorOnError">@color/arzikina_on_error</item>
        <item name="colorErrorContainer">@color/arzikina_error_container</item>
        <item name="colorOnErrorContainer">@color/arzikina_on_error_container</item>

        <!-- Coins arrondis : échelle Arzikina (voir styles ShapeAppearance ci-dessous) -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Arzikina.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Arzikina.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Arzikina.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Arzikina.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Arzikina.ExtraLarge</item>

        <!--
            Applique Widget.Arzikina.CardView (voir ci-dessous) à TOUTE
            MaterialCardView du projet sans avoir à répéter app:strokeWidth="0dp"
            dans chaque layout — une seule source de vérité, propagée
            automatiquement (nouveaux écrans compris).
        -->
        <item name="materialCardViewStyle">@style/Widget.Arzikina.CardView</item>
    </style>

    <!--
        Recadrage circulaire des avatars (photo de profil, Dashboard + écran Profil, voir
        fragment_dashboard.xml/fragment_profile.xml, ShapeableImageView) : cornerSize 50% sur une
        vue carrée donne un cercle parfait quelle que soit sa taille (48dp Dashboard, 96dp Profil) —
        une seule définition partagée plutôt qu'un pourcentage répété à chaque endroit.
    -->
    <style name="ShapeAppearanceOverlay.Arzikina.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--
        Thème DÉDIÉ à com.canhub.cropper.CropImageActivity (voir AndroidManifest.xml, section
        "Photo de profil — écran de recadrage", et docs/RAPPORT-photo-profil.md). Seule différence
        avec Theme.Arzikina : parent AVEC ActionBar (Theme.Material3.DayNight, pas ".NoActionBar")
        — cette bibliothèque affiche son bouton de validation/rotation/miroir comme des items de
        menu sur une ActionBar système, elle n'a pas de Toolbar propre dans son layout. Les couleurs
        Arzikina sont reprises telles quelles pour rester visuellement cohérent avec le reste de
        l'app malgré ce thème séparé.
    -->
    <style name="Theme.Arzikina.Cropper" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/arzikina_primary</item>
        <item name="colorOnPrimary">@color/arzikina_on_primary</item>
        <item name="colorPrimaryContainer">@color/arzikina_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/arzikina_on_primary_container</item>
    </style>

    <!--
        Le style par défaut de MaterialCardView (Widget.Material3.CardView.Elevated)
        dessine un contour de 1dp dans ?attr/colorOutlineVariant : sur les cartes à
        fond sombre fixe du Dashboard (voir @color/arzikina_balance_card), ce
        contour clair ressort comme une bordure blanche indésirable. Retiré ici
        pour toutes les cartes de l'app plutôt que carte par carte.
    -->
    <style name="Widget.Arzikina.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="strokeWidth">0dp</item>
    </style>

    <!--
        À appliquer via android:theme sur une vue posée sur une carte à fond
        sombre fixe (@color/arzikina_balance_card) : remappe localement
        colorOnSurface/colorOnSurfaceVariant vers les couleurs fixes adaptées à
        ce fond, sans toucher aux layouts partagés (ex. item_transaction_compact.xml,
        aussi utilisé par l'écran Transactions sur un fond normal, sensible au
        thème clair/sombre — voir fragment_dashboard.xml, section "Dernières
        transactions").
    -->
    <style name="ThemeOverlay.Arzikina.OnBalanceCard" parent="">
        <item name="colorOnSurface">@color/arzikina_on_balance_card</item>
        <item name="colorOnSurfaceVariant">@color/arzikina_on_balance_card_variant</item>
    </style>

    <!--
        Style partagé pour tout champ "menu déroulant" posé sur une postcard (voir
        item_dropdown_field.xml) : centralise le retrait du contour propre à OutlinedBox
        (boxStrokeWidth=0), pour éviter un double cadre "boîte dans la boîte" une fois posé sur le
        fond sombre de la carte — même raisonnement que nameLayout/balanceLayout sur
        fragment_account_form.xml, mais factorisé ici pour ne plus le répéter à chaque champ
        déroulant (voir "harmonisation des Spinner", instructions projet).
    -->
    <style name="Widget.Arzikina.TextInputLayout.ExposedDropdownMenu.PostCard" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>

    <!--
        Même principe que le style ci-dessus, pour les champs de SAISIE LIBRE (texte, nombre, mot
        de passe...) posés sur une postcard (voir nameLayout/balanceLayout sur
        fragment_account_form.xml, descriptionLayout sur fragment_transaction_form.xml) — centralise
        le retrait du contour propre à OutlinedBox, pour ne plus répéter
        boxStrokeWidth/boxStrokeWidthFocused=0dp sur chaque champ ("harmonisation des champs de
        saisie", instructions projet).
    -->
    <style name="Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>

    <!--
        Variante réservée à item_postcard_text_input.xml (refonte Login/Register) : ce template
        combine DEUX niveaux de texte de repli sur le même champ — le hint du TextInputLayout
        (libellé, ex. "Adresse e-mail") ET le hint du TextInputEditText interne (placeholder, ex.
        "votre@email.com"), pour satisfaire "icône + label + placeholder" par champ (cahier des
        charges). Par défaut, TextInputLayout affiche son hint en GRAND (position "expanded") tant
        que le champ est vide et sans focus — exactement à l'emplacement du placeholder de
        l'EditText interne, d'où un chevauchement visuel des deux textes tant qu'aucune saisie/focus
        n'a eu lieu (repéré visuellement après l'étape 4).

        `expandedHintEnabled=false` : le hint du TextInputLayout reste TOUJOURS dans sa position
        réduite (petit libellé en haut du champ), jamais agrandi — reproduit le pattern de la
        maquette (libellé toujours visible au-dessus, placeholder en dessous) et supprime le
        chevauchement. La couleur du libellé continue de passer à colorPrimary au focus (comportement
        par défaut de TextInputLayout, inchangé par cet attribut).

        Style SÉPARÉ plutôt que modification de Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard
        ci-dessus : ce dernier est aussi utilisé par des champs préexistants sans second niveau de
        placeholder (nameLayout/balanceLayout de fragment_account_form.xml,
        descriptionLayout de fragment_transaction_form.xml...) — leur comportement de hint flottant
        standard ne doit pas changer, seuls les nouveaux champs postcard de Connexion/Inscription
        sont concernés par ce chevauchement.
    -->
    <style name="Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard.Auth" parent="Widget.Arzikina.TextInputLayout.OutlinedBox.PostCard">
        <item name="expandedHintEnabled">false</item>
    </style>

    <!--
        Taille du libellé de la Bottom Navigation (voir activity_main.xml,
        app:itemTextAppearanceActive/Inactive) : plus petite que la taille
        Material3 par défaut, pour rester discrète sous l'icône avec 5 onglets
        toujours libellés (app:labelVisibilityMode="labeled").
    -->
    <style name="TextAppearance.Arzikina.BottomNavigation.Active" parent="">
        <item name="android:textSize">@dimen/text_size_bottom_nav_active</item>
    </style>

    <style name="TextAppearance.Arzikina.BottomNavigation.Inactive" parent="">
        <item name="android:textSize">@dimen/text_size_bottom_nav_inactive</item>
    </style>

    <!-- Échelle de coins arrondis Arzikina (miroir de l'échelle dimens.xml corner_radius_*). -->
    <style name="ShapeAppearance.Arzikina.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">@dimen/corner_radius_extra_small</item>
    </style>

    <style name="ShapeAppearance.Arzikina.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/corner_radius_small</item>
    </style>

    <style name="ShapeAppearance.Arzikina.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/corner_radius_medium</item>
    </style>

    <style name="ShapeAppearance.Arzikina.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/corner_radius_large</item>
    </style>

    <style name="ShapeAppearance.Arzikina.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/corner_radius_extra_large</item>
    </style>

    <!-- Forme pleinement arrondie ("pill") des boutons principaux Connexion/Inscription (voir
         Widget.Arzikina.Button.Pill juste en dessous) — cornerSize en pourcentage (50%) plutôt
         qu'un rayon fixe en dp : s'adapte automatiquement à la hauteur réelle du bouton, contrairement
         à l'échelle ExtraSmall/.../ExtraLarge ci-dessus, pensée pour des rayons fixes. -->
    <style name="ShapeAppearance.Arzikina.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!--
        Bouton principal des écrans Connexion/Inscription (voir cahier des charges "Refonte
        Login/Register") : forme pleinement arrondie (ShapeAppearance.Arzikina.Pill) et flèche de
        fin systématique (ic_arrow_forward_24), pour un seul style visuel partagé entre
        "Se connecter →" (LoginFragment) et "Créer mon compte →" (RegisterFragment) — plus besoin
        de dupliquer un `android:background` par écran (remplace l'ancien `forme_radius_10dp` posé
        directement sur `registerButton` dans fragment_register.xml, retiré à l'étape suivante de
        cette refonte au profit de ce style commun).

        État désactivé (formulaire invalide, voir `loginButton.isEnabled`/`registerButton.isEnabled`
        dans les deux Fragments) : comportement PAR DÉFAUT de Widget.Material3.Button (désaturation
        automatique), volontairement non recustomisé ici — aucun autre bouton du projet ne redéfinit
        cet état, pas de raison de commencer sur ces deux écrans seulement.
    -->
    <style name="Widget.Arzikina.Button.Pill" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Arzikina.Pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">@dimen/spacing_m</item>
        <item name="android:paddingBottom">@dimen/spacing_m</item>
        <item name="icon">@drawable/ic_arrow_forward_24</item>
        <item name="iconGravity">end</item>
        <item name="iconPadding">@dimen/spacing_s</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>
</resources>
