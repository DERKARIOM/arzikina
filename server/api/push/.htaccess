# Dossier de BIBLIOTHÈQUES PHP (envoi FCM) et de scripts en ligne de commande : rien ici ne doit
# être appelable par une URL. Les endpoints publics (`api/devices/*`, `api/auth/logout.php`) les
# incluent par le système de fichiers, ce qui n'est pas concerné par ce blocage.
# Double syntaxe : Apache 2.4 / LiteSpeed (Hostinger) et anciens Apache 2.2.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
