# Filet de sécurité : si jamais une vraie copie des fichiers de secrets atterrit ici par erreur
# (au lieu de /home/Admin/ sur le serveur, où elle doit rester), Git l'ignore quand même — voir
# config/secrets.example.php et docs/sync/AUDIT-ET-ARCHITECTURE-SYNC.md, section 24.
config_arzikina.php
config_arzikina_secrets.php
secrets.php
.env
.env.*
!secrets.example.php
# Compte de service Firebase (clé privée) et cache du jeton d'accès FCM : uniquement dans $HOME sur
# le serveur, jamais dans le dépôt — voir api/push/FcmSender.php.
firebase-service-account.json
*-service-account*.json
.arzikina-fcm-access-token.json
# Logos d'émetteur de reçus envoyés par les utilisateurs (voir api/utils/issuer_logo.php) : jamais versionnés,
# seul le .htaccess qui protège le dossier l'est.
issuer_logos/*
!issuer_logos/.htaccess
