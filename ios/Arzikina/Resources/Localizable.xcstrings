    "account.form.exclude_statistics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude from statistics"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclure des statistiques"
          }
        }
      }
    },
    "account.form.exclude_statistics_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account stays visible and fully usable, but its balance and transactions will no longer count in your personal statistics (dashboard, income/expenses, budgets). Useful for money you manage on someone else's behalf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte reste visible et pleinement utilisable, mais son solde et ses transactions ne compteront plus dans vos statistiques personnelles (tableau de bord, revenus/dépenses, budgets). Utile pour de l'argent géré pour le compte de quelqu'un d'autre."
          }
        }
      }
    },
    "account.form.initial_balance": {
