    "account.form.savings_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress is calculated automatically from the account balance: every transaction or transfer to this goal moves it forward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression est calculée automatiquement à partir du solde du compte : chaque transaction ou transfert vers cet objectif la fait avancer."
