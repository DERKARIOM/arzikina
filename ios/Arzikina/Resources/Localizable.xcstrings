    "account.form.savings_remove.message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will no longer be a savings goal: its target amount and description will be removed. The balance and all transactions are kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne sera plus un objectif d'épargne : son montant cible et sa description seront supprimés. Le solde et toutes les transactions sont conservés."
          }
        }
      }
    },
