    "account.form.card_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the last 4 digits and the expiry date are saved. The full number and security code are never requested."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les 4 derniers chiffres et la date d'expiration sont enregistrés. Le numéro complet et le code de sécurité ne sont jamais demandés."
          }
        }
      }
    },
