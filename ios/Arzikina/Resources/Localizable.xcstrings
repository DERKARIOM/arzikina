    "account.delete.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le compte"
          }
        }
      }
    },
    "account.delete.automations %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld automation or template uses this account: it will stop working until you edit it on Android or the web."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld automations or templates use this account: they will stop working until you edit them on Android or the web."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld automatisation ou modèle utilise ce compte : il ne fonctionnera plus tant que tu ne l'auras pas modifié sur Android ou le Web."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld automatisations ou modèles utilisent ce compte : ils ne fonctionneront plus tant que tu ne les auras pas modifiés sur Android ou le Web."
                }
              }
            }
          }
        }
      }
    },
    "account.delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le compte"
          }
        }
      }
    },
    "account.delete.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't delete the account. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression a échoué. Réessaie."
          }
        }
      }
    },
    "account.delete.loans %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld loan will be deleted with its repayments."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld loans will be deleted with their repayments."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld prêt / emprunt sera supprimé avec ses remboursements."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld prêts / emprunts seront supprimés avec leurs remboursements."
                }
              }
            }
          }
        }
      }
    },
    "account.delete.message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”? This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ » ? Cette action est irréversible."
          }
        }
      }
    },
    "account.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this account?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce compte ?"
          }
        }
      }
    },
    "account.delete.transactions %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transaction will also be deleted (with its fees)."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transactions will also be deleted (with their fees)."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transaction sera aussi supprimée (avec ses frais)."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transactions seront aussi supprimées (avec leurs frais)."
                }
              }
            }
          }
        }
      }
    },
